// Ventana principal de OmniLoad, con la distribución de JDownloader: pestañas
// Descargas / Capturador de enlaces, tabla en árbol de paquetes, resumen y
// barra inferior. Ajustes › Apariencia cambia el tema en caliente.
//
// La lógica vive en Rust (src/); aquí solo está la presentación.

// Tipografía propia (Inter, licencia OFL): así las letras se ven igual en
// todos los equipos y no dependen de las fuentes ni del suavizado del sistema.
import "fonts/Inter-Regular.otf";
import "fonts/Inter-Medium.otf";
import "fonts/Inter-SemiBold.otf";
import "fonts/Inter-Bold.otf";
import { ListView, Palette, ScrollView } from "std-widgets.slint";

// ---------------------------------------------------------------- Tema ----

// Los cinco temas aprobados. `kind`: 0 Cristal claro, 1 Cristal oscuro,
// 2 Claro, 3 Grafito, 4 Alto contraste.
export global Theme {
    in-out property <int> kind: 0;
    in-out property <bool> follow-system: true;
    // Lo rellena la ventana al arrancar con el modo del sistema.
    in-out property <bool> system-dark: false;
    in-out property <int> accent-index: 0;
    in-out property <bool> compact: false;
    in-out property <bool> reduce-transparency: false;
    // Tamaño de letra: 0 pequeño, 1 normal, 2 grande.
    in-out property <int> font-level: 1;
    // Desenfoque de sombras y brillos del cristal: 0 suave, 1 normal, 2 fuerte.
    in-out property <int> blur-level: 1;
    out property <float> fscale: [0.9, 1.0, 1.15][font-level];
    out property <length> shadow-blur: [14px, 32px, 56px][blur-level];

    // Tema efectivo: con "según el sistema", cada tema pasa a su pareja
    // clara u oscura (Cristal claro ↔ Cristal oscuro, Claro ↔ Grafito).
    out property <int> eff: !follow-system || kind == 4 ? kind
        : kind <= 1 ? (system-dark ? 1 : 0)
        : (system-dark ? 3 : 2);
    out property <bool> dark: eff == 1 || eff == 3 || eff == 4;
    out property <bool> glass: eff <= 1 && !reduce-transparency;
    // Paleta de los paneles: "Reducir transparencia" usa la plana equivalente.
    out property <int> pal: glass || eff > 1 ? eff : (eff == 0 ? 2 : 3);

    out property <color> wall: [#eef1f6, #0d1017, #eef0f3, #121418, #000000][eff];
    out property <color> blob1: [#78a0f029, #5078dc1f, #00000000, #00000000, #00000000][eff];
    out property <color> blob2: [#beaaf01f, #8c64dc17, #00000000, #00000000, #00000000][eff];
    out property <color> panel: [#ffffff80, #1c223685, #ffffff, #1c1f25, #000000][pal];
    out property <color> panel2: [#ffffff5c, #28304a61, #f7f8fa, #22262d, #0d0d0d][pal];
    out property <color> head: [#ffffff8c, #323a5880, #f3f4f7, #252930, #000000][pal];
    out property <color> rim: [#ffffffc7, #ffffff29, #d9dde4, #323844, #ffffff][pal];
    out property <color> spec: [#fffffff2, #ffffff42, #00000000, #00000000, #00000000][pal];
    out property <color> shadow: [#1e285029, #00000073, #0000000d, #00000000, #00000000][pal];
    out property <color> text: [#0d1424, #f2f5fb, #14181f, #e9ecf2, #ffffff][pal];
    out property <color> muted: [#3e4a5f, #b3bdd0, #4f5867, #a3acbb, #e6e6e6][pal];
    out property <color> line: [#141e3c1a, #ffffff14, #e8eaef, #2b3039, #666666][pal];
    out property <color> track: [#141e3c1f, #ffffff24, #e3e6ec, #323844, #4d4d4d][pal];

    out property <color> accent: eff == 4 ? #ffd400 : dark
        ? [#6fb1ff, #b39bff, #5fd49a, #ffab6b, #ff8fc0, #c9d1de][accent-index]
        : [#0a5fd0, #6a3fd6, #137a4b, #b4500a, #b8306a, #3d4654][accent-index];
    out property <color> on-accent: eff == 4 ? #000000 : dark ? #06142b : #ffffff;
    out property <color> selbg: eff == 4 ? #332b00 : accent.with-alpha(0.16);
    out property <color> ok: eff == 4 ? #6dff9e : dark ? #5fd49a : #127a46;
    out property <color> warn: eff == 4 ? #ffd400 : dark ? #f3b860 : #93560a;
    out property <color> err: eff == 4 ? #ff7b7b : dark ? #ff8a80 : #b3261e;

    // Capas de estado (pasar el ratón, pulsar) que funcionan en cualquier tema:
    // una película del color del texto sobre lo que haya debajo.
    out property <color> hover: text.with-alpha(eff == 4 ? 0.22 : 0.07);
    out property <color> press: text.with-alpha(eff == 4 ? 0.34 : 0.13);
    // Cuadros de texto y selectores: algo más hundidos que el panel.
    out property <color> field: [#ffffffb3, #0f1424a6, #ffffff, #181b20, #000000][pal];
    // Barra de título: se funde con la ventana en cada tema.
    out property <color> bar: [#ffffffb3, #1c2236b0, #f3f4f7, #1a1d22, #000000][eff];
    out property <color> bar-line: [#141e3c24, #ffffff1f, #d9dde4, #2b3039, #ffffff][eff];
    // Anillo de foco (teclado) y halo del campo enfocado.
    out property <color> ring: accent.with-alpha(0.55);
    // Fondo (opaco) de los menús desplegables.
    out property <color> menu-bg: eff == 4 ? #000000 : eff == 1 ? #1c2236 : eff == 3 ? #22262d : #ffffff;
    out property <length> r: eff <= 1 ? 18px : eff == 4 ? 2px : 8px;
    out property <length> r2: eff <= 1 ? 10px : eff == 4 ? 2px : 6px;
    out property <length> lw: eff == 4 ? 2px : 1px;
    out property <length> row-h: (compact ? 26px : 34px) * fscale;
    out property <length> font: (compact ? 12.5px : 13px) * fscale;

    // Color de un estado: 0 acento, 1 bien, 2 aviso, 3 error, 4 apagado.
    public pure function tone(t: int) -> color {
        if t == 1 { return ok; }
        if t == 2 { return warn; }
        if t == 3 { return err; }
        if t == 4 { return muted; }
        return accent;
    }
}

// ----------------------------------------------------------- Modelos ----

export struct DlRow {
    key: int,
    is-package: bool,
    expanded: bool,
    selected: bool,
    name: string,
    host: string,
    size: string,
    // 0..1; negativo si no se conoce el tamaño.
    fraction: float,
    progress: string,
    speed: string,
    eta: string,
    priority: string,
    status: string,
    tone: int,
}

export struct GrabTreeRow {
    key: int,
    is-package: bool,
    expanded: bool,
    selected: bool,
    checked: bool,
    dim: bool,
    name: string,
    host: string,
    size: string,
    avail: string,
    tone: int,
    priority: string,
    dest: string,
}

export struct Stat {
    label: string,
    value: string,
}

// ------------------------------------------------------ Componentes ----

component Icon inherits Path {
    in property <length> size: 14px;
    in property <bool> filled: false;
    in property <color> ink: Theme.text;
    width: size;
    height: size;
    viewbox-width: 24;
    viewbox-height: 24;
    stroke: filled ? transparent : ink;
    fill: filled ? ink : transparent;
    stroke-width: 2.2px;
    stroke-line-cap: round;
}

// Un panel de la ventana: cristal (translúcido, borde claro, brillo arriba y
// sombra) o plano, según el tema.
component Panel inherits Rectangle {
    background: Theme.panel;
    border-color: Theme.rim;
    border-width: Theme.lw;
    border-radius: Theme.r;
    drop-shadow-blur: Theme.glass ? Theme.shadow-blur : 0px;
    drop-shadow-offset-y: Theme.glass ? 12px : 0px;
    drop-shadow-color: Theme.shadow;
    @children
    Rectangle {
        x: Theme.r;
        y: 1px;
        width: max(0px, parent.width - 2 * Theme.r);
        height: 1px;
        background: Theme.spec;
    }
}

// Una columna de una tabla (el orden del modelo es el orden en pantalla).
export struct ColState {
    // Descargas: 0 Nombre, 1 Host, 2 Tamaño, 3 Progreso, 4 Velocidad,
    // 5 Restante, 6 Prioridad, 7 Estado. Capturador: 0 Nombre, 1 Host,
    // 2 Tamaño, 3 Disponibilidad, 4 Prioridad, 5 Guardar en.
    id: int,
    name: string,
    width: length,
    shown: bool,
}

// Una regla por tipo de archivo en Ajustes › Automático.
struct RuleRow {
    exts: string,
    folder: string,
}

// Cuadro de texto propio (de una línea). Misma interfaz que el LineEdit
// estándar: `text`, `placeholder-text`, `edited`, `accepted`, `has-focus`.
component LineEdit inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <string> placeholder-text;
    in property <bool> enabled: true;
    // Botón × para vaciarlo.
    in property <bool> clearable: false;
    out property <bool> has-focus: input.has-focus;
    callback edited(string);
    callback accepted(string);
    forward-focus: input;
    height: (Theme.compact ? 30px : 34px) * Theme.fscale;
    min-width: 60px;
    horizontal-stretch: 1;
    border-radius: Theme.r2;
    border-width: input.has-focus ? 1.5px : Theme.lw;
    border-color: input.has-focus ? Theme.accent : area.has-hover ? Theme.text.with-alpha(0.22) : Theme.rim;
    background: Theme.field;
    opacity: enabled ? 1 : 0.5;
    drop-shadow-blur: input.has-focus ? 8px : 0px;
    drop-shadow-color: Theme.accent.with-alpha(0.35);
    animate border-color { duration: 100ms; }
    area := TouchArea {
        mouse-cursor: MouseCursor.text;
        clicked => { input.focus(); }
    }
    HorizontalLayout {
        padding-left: 11px;
        padding-right: 8px;
        spacing: 6px;
        Rectangle {
            horizontal-stretch: 1;
            min-width: 0px;
            clip: true;
            if input.text == "" && root.placeholder-text != "": Text {
                text: root.placeholder-text;
                font-size: Theme.font;
                color: Theme.muted.with-alpha(0.75);
                vertical-alignment: center;
                overflow: elide;
            }
            // El texto largo se desplaza dentro de la caja (no se sale de ella).
            flick := Flickable {
                interactive: false;
                viewport-width: input.width;
                viewport-height: self.height;
                input := TextInput {
                    x: 0px;
                    y: 0px;
                    width: max(flick.width, self.preferred-width + 2px);
                    height: flick.height;
                    single-line: true;
                    enabled: root.enabled;
                    font-size: Theme.font;
                    color: Theme.text;
                    vertical-alignment: center;
                    selection-background-color: Theme.accent.with-alpha(0.35);
                    selection-foreground-color: Theme.text;
                    edited => { root.edited(self.text); }
                    accepted => { root.accepted(self.text); }
                    cursor-position-changed(p) => {
                        if p.x + flick.viewport-x < 0px {
                            flick.viewport-x = -p.x;
                        } else if p.x + flick.viewport-x > flick.width - 3px {
                            flick.viewport-x = -(p.x - flick.width + 3px);
                        }
                    }
                }
            }
        }
        if root.clearable && input.text != "": VerticalLayout {
            alignment: center;
            Rectangle {
                width: 20px;
                height: 20px;
                border-radius: 10px;
                background: clear.has-hover ? Theme.press : transparent;
                accessible-role: button;
                accessible-label: "Borrar";
                Icon {
                    size: 11px;
                    x: 4.5px;
                    y: 4.5px;
                    commands: "M6 6l12 12M18 6L6 18";
                    ink: Theme.muted;
                    stroke-width: 2.6px;
                }
                clear := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        input.text = "";
                        root.edited("");
                        input.focus();
                    }
                }
            }
        }
    }
}

// Cuadro de texto de varias líneas (como el LineEdit, para pegar enlaces).
component TextEdit inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <string> placeholder-text;
    in property <TextWrap> wrap: word-wrap;
    forward-focus: input;
    border-radius: Theme.r2;
    border-width: input.has-focus ? 1.5px : Theme.lw;
    border-color: input.has-focus ? Theme.accent : Theme.rim;
    background: Theme.field;
    drop-shadow-blur: input.has-focus ? 8px : 0px;
    drop-shadow-color: Theme.accent.with-alpha(0.35);
    animate border-color { duration: 100ms; }
    TouchArea {
        mouse-cursor: MouseCursor.text;
        clicked => { input.focus(); }
    }
    Flickable {
        interactive: false;
        viewport-height: max(self.height, input.preferred-height + 24px);
        if input.text == "" && root.placeholder-text != "": Text {
            x: 12px;
            y: 12px;
            width: parent.width - 24px;
            text: root.placeholder-text;
            wrap: word-wrap;
            font-size: Theme.font;
            color: Theme.muted.with-alpha(0.75);
        }
        input := TextInput {
            x: 12px;
            y: 12px;
            width: parent.width - 24px;
            wrap: root.wrap;
            font-size: Theme.font;
            color: Theme.text;
            selection-background-color: Theme.accent.with-alpha(0.35);
            selection-foreground-color: Theme.text;
        }
    }
}

component Btn inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> icon-filled: false;
    in property <color> icon-color: primary ? Theme.on-accent : Theme.text;
    in property <bool> primary: false;
    in property <bool> enabled: true;
    in property <string> label: text;
    callback clicked();

    accessible-role: button;
    accessible-label: label;
    accessible-action-default => { if enabled { clicked(); } }
    forward-focus: focus;
    height: (Theme.compact ? 30px : 34px) * Theme.fscale;
    min-width: max(self.height, content.min-width);
    horizontal-stretch: 0;
    border-radius: Theme.r2;
    border-width: Theme.lw;
    border-color: primary ? Theme.accent : touch.has-hover ? Theme.text.with-alpha(0.22) : Theme.rim;
    background: primary ? Theme.accent : Theme.panel2;
    opacity: enabled ? 1 : 0.45;
    // Capa de hover/pulsado.
    Rectangle {
        border-radius: parent.border-radius;
        background: !root.enabled ? transparent
            : touch.pressed ? (root.primary ? #00000030 : Theme.press)
            : touch.has-hover ? (root.primary ? #ffffff26 : Theme.hover)
            : transparent;
        animate background { duration: 90ms; }
    }
    // Anillo de foco con teclado.
    if focus.has-focus: Rectangle {
        x: -2px; y: -2px;
        width: parent.width + 4px;
        height: parent.height + 4px;
        border-radius: Theme.r2 + 2px;
        border-width: 2px;
        border-color: Theme.ring;
    }
    content := HorizontalLayout {
        padding-left: text == "" ? 0px : 14px;
        padding-right: text == "" ? 0px : 14px;
        spacing: 7px;
        alignment: center;
        if icon != "": VerticalLayout {
            alignment: center;
            Icon {
                commands: icon;
                filled: icon-filled;
                ink: icon-color;
            }
        }
        if text != "": Text {
            text: root.text;
            color: primary ? Theme.on-accent : Theme.text;
            font-size: Theme.font;
            font-weight: primary ? 600 : 500;
            vertical-alignment: center;
        }
    }
    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(e) => {
            if e.text == " " || e.text == "\n" {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { focus.focus(); root.clicked(); }
    }
}

component Check inherits Rectangle {
    in-out property <bool> checked;
    in property <bool> enabled: true;
    in property <string> label;
    callback toggled(bool);
    accessible-role: checkbox;
    accessible-checkable: true;
    accessible-checked: checked;
    accessible-label: label;
    forward-focus: focus;
    width: 18px;
    height: 18px;
    border-radius: 5px;
    border-width: checked ? 0px : 1.5px;
    border-color: touch.has-hover ? Theme.text : Theme.muted;
    background: checked ? Theme.accent : touch.has-hover ? Theme.hover : transparent;
    opacity: enabled ? 1 : 0.4;
    animate background { duration: 120ms; }
    if focus.has-focus: Rectangle {
        x: -3px; y: -3px;
        width: parent.width + 6px;
        height: parent.height + 6px;
        border-radius: 8px;
        border-width: 2px;
        border-color: Theme.ring;
    }
    Icon {
        size: 12px;
        x: 3px;
        y: 3px;
        commands: "M5 12l5 5 9-10";
        ink: Theme.on-accent;
        stroke-width: 3px;
        opacity: checked ? 1 : 0;
        animate opacity { duration: 120ms; }
    }
    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(e) => {
            if e.text == " " {
                root.checked = !root.checked;
                root.toggled(root.checked);
                return accept;
            }
            return reject;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            focus.focus();
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}

component LabeledCheck inherits HorizontalLayout {
    in property <string> text;
    in-out property <bool> checked;
    callback toggled(bool);
    spacing: 8px;
    alignment: start;
    Check {
        y: (parent.height - self.height) / 2;
        checked <=> root.checked;
        label: root.text;
        toggled(v) => { root.toggled(v); }
    }
    Text {
        text: root.text;
        color: Theme.text;
        font-size: Theme.font;
        vertical-alignment: center;
        TouchArea {
            clicked => {
                root.checked = !root.checked;
                root.toggled(root.checked);
            }
        }
    }
}

component Sep inherits Rectangle {
    width: 1px;
    height: 24px;
    background: Theme.rim;
}

component Bar inherits Rectangle {
    in property <float> fraction;
    in property <string> text;
    in property <color> fill: Theme.accent;
    height: 18px;
    border-radius: 9px;
    background: Theme.track;
    clip: true;
    Rectangle {
        x: 0;
        width: parent.width * max(0, root.fraction);
        background: @linear-gradient(90deg, root.fill.darker(0.15) 0%, root.fill 100%);
        border-radius: 9px;
        animate width { duration: 250ms; easing: ease-out; }
    }
    Text {
        x: 8px;
        text: root.text;
        font-size: 11px * Theme.fscale;
        font-weight: 700;
        color: Theme.text;
        vertical-alignment: center;
    }
}

component Cell inherits Text {
    font-size: Theme.font;
    color: Theme.text;
    vertical-alignment: center;
    overflow: elide;
}

// Hueco de una columna: ancho propio, sin estirarse (un ancho de columna no
// afecta a las demás; lo que sobra queda a la derecha).
component ColSlot inherits Rectangle {
    in property <ColState> spec;
    visible: spec.shown;
    min-width: spec.shown ? spec.width : 0px;
    max-width: spec.shown ? spec.width : 0px;
    preferred-width: spec.shown ? spec.width : 0px;
    horizontal-stretch: 0;
}

// Cabecera de una tabla: arrastrar el borde derecho cambia el ancho y
// arrastrar el nombre de una columna la cambia de sitio.
component ColsHeader inherits Rectangle {
    in property <[ColState]> cols;
    // Nuevo ancho (absoluto) de la columna `i` mientras se arrastra su borde.
    callback resize(int, length);
    callback resize-done();
    // Columna que se suelta y posición del ratón dentro de la cabecera.
    callback reorder(int, length);
    in-out property <int> dragging: -1;
    in-out property <length> pointer-x;
    height: 34px;
    background: Theme.head;
    HorizontalLayout {
        for c[i] in root.cols: ColSlot {
            spec: c;
            property <bool> hot: root.dragging >= 0 && root.dragging != i
                && root.pointer-x >= self.absolute-position.x
                && root.pointer-x < self.absolute-position.x + self.width;
            property <length> press-x;
            property <bool> pressing: false;
            property <length> w0;
            property <length> x0;
            property <bool> sizing: false;
            Rectangle {
                background: root.dragging == i ? Theme.accent.with-alpha(0.28)
                    : hot ? Theme.accent.with-alpha(0.16)
                    : grab.has-hover ? Theme.hover : transparent;
                animate background { duration: 90ms; }
            }
            Text {
                x: 12px;
                width: parent.width - 16px;
                text: c.name;
                font-size: 11.5px * Theme.fscale;
                font-weight: 700;
                color: root.dragging == i ? Theme.text : Theme.muted;
                vertical-alignment: center;
                overflow: elide;
            }
            if hot: Rectangle {
                x: 0;
                width: 3px;
                background: Theme.accent;
            }
            Rectangle {
                x: parent.width - 1px;
                y: 8px;
                width: 1px;
                height: parent.height - 16px;
                background: Theme.rim;
            }
            grab := TouchArea {
                mouse-cursor: pointer;
                pointer-event(e) => {
                    if e.button == PointerEventButton.left {
                        if e.kind == PointerEventKind.down {
                            pressing = true;
                            press-x = self.absolute-position.x + self.mouse-x;
                        } else if e.kind == PointerEventKind.up {
                            if root.dragging == i {
                                root.dragging = -1;
                                root.reorder(i, root.pointer-x - root.absolute-position.x);
                            }
                            pressing = false;
                        }
                    }
                }
                moved => {
                    if pressing {
                        root.pointer-x = self.absolute-position.x + self.mouse-x;
                        if root.dragging == i || abs(root.pointer-x - press-x) > 6px {
                            root.dragging = i;
                        }
                    }
                }
            }
            // Asa para el ancho, siempre encima.
            TouchArea {
                x: parent.width - 6px;
                width: 12px;
                mouse-cursor: col-resize;
                Rectangle {
                    x: 5px;
                    width: 2px;
                    background: parent.has-hover || parent.pressed ? Theme.accent : transparent;
                }
                pointer-event(e) => {
                    if e.button == PointerEventButton.left {
                        if e.kind == PointerEventKind.down {
                            sizing = true;
                            w0 = c.width;
                            x0 = self.absolute-position.x + self.mouse-x;
                        } else if e.kind == PointerEventKind.up {
                            sizing = false;
                            root.resize-done();
                        }
                    }
                }
                moved => {
                    if sizing {
                        root.resize(i, max(48px, w0 + (self.absolute-position.x + self.mouse-x - x0)));
                    }
                }
            }
        }
        Rectangle { horizontal-stretch: 1; }
    }
    // Lo que se arrastra, siguiendo al ratón.
    if root.dragging >= 0: Rectangle {
        x: root.pointer-x - root.absolute-position.x - 44px;
        y: 4px;
        width: 88px;
        height: parent.height - 8px;
        border-radius: Theme.r2;
        background: Theme.accent;
        drop-shadow-blur: 10px;
        drop-shadow-color: #00000050;
        Text {
            text: root.cols[root.dragging].name;
            font-size: 11.5px * Theme.fscale;
            font-weight: 700;
            color: Theme.on-accent;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    Rectangle {
        y: parent.height - Theme.lw;
        height: Theme.lw;
        background: Theme.rim;
    }
}

component Expander inherits Rectangle {
    in property <bool> expanded;
    callback toggle();
    width: 22px;
    height: 22px;
    accessible-role: button;
    accessible-label: expanded ? "Contraer paquete" : "Desplegar paquete";
    accessible-action-default => { toggle(); }
    Icon {
        size: 12px;
        x: 5px;
        y: 5px;
        commands: expanded ? "M6 9l6 6 6-6" : "M9 6l6 6-6 6";
        stroke-width: 3px;
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggle(); }
    }
}

component FolderIcon inherits Icon {
    size: 16px;
    commands: "M3 6a2 2 0 0 1 2-2h4l2 3h8a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z";
    ink: Theme.accent;
    stroke-width: 2px;
}

// Columnas de las tablas: las pone Rust (ajustes guardados).
export global DlCols {
    in-out property <[ColState]> cols;
    callback resize(int, length);
    callback resize-done();
    callback reorder(int, length);
}

export global GrabCols {
    in-out property <[ColState]> cols;
    callback resize(int, length);
    callback resize-done();
    callback reorder(int, length);
}

component DlLine inherits Rectangle {
    in property <DlRow> item;
    in property <[ColState]> cols;
    callback clicked();
    callback toggle();
    height: Theme.row-h;
    background: item.selected ? Theme.selbg : touch.has-hover ? Theme.hover : item.is-package ? Theme.panel2 : transparent;
    animate background { duration: 70ms; }
    touch := TouchArea { clicked => { root.clicked(); } }
    HorizontalLayout {
        for c in root.cols: ColSlot {
            spec: c;
            if c.id == 0: HorizontalLayout {
                padding-left: item.is-package ? 8px : 36px;
                padding-right: 8px;
                spacing: 6px;
                if item.is-package: VerticalLayout {
                    alignment: center;
                    Expander {
                        expanded: item.expanded;
                        toggle => { root.toggle(); }
                    }
                }
                if item.is-package: VerticalLayout {
                    alignment: center;
                    FolderIcon { }
                }
                Cell {
                    text: item.name;
                    font-weight: item.is-package ? 600 : 400;
                    horizontal-stretch: 1;
                }
            }
            if c.id == 1: Cell { x: 12px; width: parent.width - 16px; text: item.host; color: Theme.muted; }
            if c.id == 2: Cell { x: 12px; width: parent.width - 16px; text: item.size; }
            if c.id == 3: VerticalLayout {
                alignment: center;
                padding-left: 12px;
                padding-right: 12px;
                Bar {
                    fraction: item.fraction;
                    text: item.progress;
                    fill: Theme.tone(item.tone);
                }
            }
            if c.id == 4: Cell { x: 12px; width: parent.width - 16px; text: item.speed; }
            if c.id == 5: Cell { x: 12px; width: parent.width - 16px; text: item.eta; }
            if c.id == 6: Cell { x: 12px; width: parent.width - 16px; text: item.priority; }
            if c.id == 7: Cell {
                x: 12px;
                width: parent.width - 16px;
                text: item.status;
                color: Theme.tone(item.tone);
                font-weight: 600;
            }
        }
    }
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.line;
    }
}

component GrabLine inherits Rectangle {
    in property <GrabTreeRow> item;
    in property <[ColState]> cols;
    callback clicked();
    callback toggle();
    callback check(bool);
    height: Theme.row-h;
    background: item.selected ? Theme.selbg : touch.has-hover ? Theme.hover : item.is-package ? Theme.panel2 : transparent;
    animate background { duration: 70ms; }
    touch := TouchArea { clicked => { root.clicked(); } }
    HorizontalLayout {
        for c in root.cols: ColSlot {
            spec: c;
            if c.id == 0: HorizontalLayout {
                padding-left: item.is-package ? 8px : 28px;
                padding-right: 8px;
                spacing: 8px;
                if item.is-package: VerticalLayout {
                    alignment: center;
                    Expander {
                        expanded: item.expanded;
                        toggle => { root.toggle(); }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Check {
                        checked: item.checked;
                        label: "Incluir " + item.name;
                        toggled(v) => { root.check(v); }
                    }
                }
                if item.is-package: VerticalLayout {
                    alignment: center;
                    FolderIcon { }
                }
                Cell {
                    text: item.name;
                    font-weight: item.is-package ? 600 : 400;
                    opacity: item.dim ? 0.55 : 1;
                    horizontal-stretch: 1;
                }
            }
            if c.id == 1: Cell { x: 12px; width: parent.width - 16px; text: item.host; color: Theme.muted; }
            if c.id == 2: Cell { x: 12px; width: parent.width - 16px; text: item.size; }
            if c.id == 3: Cell {
                x: 12px;
                width: parent.width - 16px;
                text: item.avail;
                color: Theme.tone(item.tone);
                font-weight: 600;
            }
            if c.id == 4: Cell { x: 12px; width: parent.width - 16px; text: item.priority; }
            if c.id == 5: Cell { x: 12px; width: parent.width - 16px; text: item.dest; color: Theme.muted; }
        }
    }
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.line;
    }
}

// Botón «Columnas» con el menú para mostrar, ocultar y ordenar columnas.
component ColsMenu inherits Btn {
    in property <[ColState]> cols;
    callback toggle(int);
    callback move(int, int);
    callback reset();
    label: "Columnas";
    icon: "M5 5v14M12 5v14M19 5v14";
    text: "";
    clicked => { menu.show(); }
    menu := PopupWindow {
        x: parent.width - 250px;
        y: parent.height + 4px;
        width: 250px;
        Rectangle {
            background: Theme.menu-bg;
            border-radius: Theme.r;
            border-width: 1px;
            border-color: Theme.rim;
            drop-shadow-blur: 24px;
            drop-shadow-offset-y: 8px;
            drop-shadow-color: #00000055;
            VerticalLayout {
                padding: 10px;
                spacing: 2px;
                Text {
                    text: "Columnas";
                    font-size: 13px * Theme.fscale;
                    font-weight: 700;
                    color: Theme.text;
                }
                Text {
                    text: "Marca las que quieres ver. También puedes arrastrar las cabeceras para cambiarlas de sitio.";
                    font-size: 11.5px * Theme.fscale;
                    color: Theme.muted;
                    wrap: word-wrap;
                }
                Rectangle { height: 6px; }
                for c[i] in root.cols: Rectangle {
                    height: 34px;
                    border-radius: 8px;
                    background: row-ta.has-hover ? Theme.hover : transparent;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 4px;
                        spacing: 10px;
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 18px;
                                height: 18px;
                                border-radius: 5px;
                                border-width: c.shown ? 0px : 1.5px;
                                border-color: Theme.muted;
                                background: c.shown ? Theme.accent : transparent;
                                opacity: c.id == 0 ? 0.55 : 1;
                                accessible-role: checkbox;
                                accessible-checkable: true;
                                accessible-checked: c.shown;
                                accessible-label: c.name;
                                if c.shown: Icon { size: 12px; x: 3px; y: 3px; commands: "M5 12l5 5 9-10"; ink: Theme.on-accent; stroke-width: 3px; }
                            }
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: c.name;
                            font-size: Theme.font;
                            color: Theme.text;
                            vertical-alignment: center;
                        }
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 26px;
                                height: 26px;
                                border-radius: 7px;
                                opacity: i > 0 ? 1 : 0.3;
                                background: up.has-hover && i > 0 ? Theme.press : transparent;
                                Icon { size: 14px; x: 6px; y: 6px; commands: "M6 15l6-6 6 6"; ink: Theme.muted; }
                                accessible-role: button;
                                accessible-label: "Subir " + c.name;
                                up := TouchArea { enabled: i > 0; mouse-cursor: pointer; clicked => { root.move(i, -1); } }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 26px;
                                height: 26px;
                                border-radius: 7px;
                                opacity: i < root.cols.length - 1 ? 1 : 0.3;
                                background: down.has-hover && i < root.cols.length - 1 ? Theme.press : transparent;
                                Icon { size: 14px; x: 6px; y: 6px; commands: "M6 9l6 6 6-6"; ink: Theme.muted; }
                                accessible-role: button;
                                accessible-label: "Bajar " + c.name;
                                down := TouchArea { enabled: i < root.cols.length - 1; mouse-cursor: pointer; clicked => { root.move(i, 1); } }
                            }
                        }
                    }
                    row-ta := TouchArea {
                        width: parent.width - 70px;
                        mouse-cursor: c.id == 0 ? MouseCursor.default : MouseCursor.pointer;
                        clicked => { if c.id != 0 { root.toggle(i); } }
                    }
                }
                Rectangle { height: 6px; }
                Btn { text: "Restablecer columnas"; clicked => { root.reset(); } }
            }
        }
    }
}

component FieldLabel inherits Text {
    font-size: 12px * Theme.fscale;
    font-weight: 600;
    color: Theme.muted;
}

// Título de sección de Ajustes: grande, con una raya de acento y una línea
// que lo separa de lo anterior, para que se vea dónde empieza cada grupo.
component SectionTitle inherits VerticalLayout {
    in property <string> text;
    in property <bool> first: false;
    padding-top: first ? 4px : 22px;
    padding-bottom: 6px;
    spacing: 12px;
    if !first: Rectangle {
        height: 1px;
        background: Theme.line;
    }
    HorizontalLayout {
        spacing: 10px;
        Rectangle {
            width: 4px;
            height: 20px;
            border-radius: 2px;
            background: Theme.accent;
        }
        Text {
            text: root.text;
            font-size: 19px * Theme.fscale;
            font-weight: 700;
            color: Theme.text;
            vertical-alignment: center;
        }
    }
}

// Botones de opción en fila ("Abajo | A la derecha | Oculto").
component Segmented inherits Rectangle {
    in property <[string]> options;
    in-out property <int> current;
    callback changed-by-user(int);
    border-radius: Theme.r2;
    border-width: Theme.lw;
    border-color: Theme.rim;
    background: Theme.panel2;
    HorizontalLayout {
        padding: 3px;
        spacing: 2px;
        for opt[i] in options: Rectangle {
            height: 32px;
            border-radius: Theme.r2 - 2px;
            background: i == root.current ? Theme.panel : segta.has-hover ? Theme.hover : transparent;
            border-width: i == root.current ? Theme.lw : 0px;
            border-color: Theme.rim;
            animate background { duration: 90ms; }
            accessible-role: button;
            accessible-label: opt;
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                Text {
                    text: opt;
                    font-size: 13px * Theme.fscale;
                    font-weight: 600;
                    color: Theme.text;
                    vertical-alignment: center;
                }
            }
            segta := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.current = i;
                    root.changed-by-user(i);
                }
            }
        }
    }
}

component SettingRow inherits HorizontalLayout {
    in property <string> title;
    in property <string> subtitle;
    padding-top: 12px;
    padding-bottom: 12px;
    spacing: 16px;
    VerticalLayout {
        horizontal-stretch: 1;
        alignment: center;
        spacing: 2px;
        Text { text: root.title; font-size: 14px * Theme.fscale; font-weight: 600; color: Theme.text; }
        if root.subtitle != "": Text {
            text: root.subtitle;
            font-size: 13px * Theme.fscale;
            color: Theme.muted;
            wrap: word-wrap;
        }
    }
    @children
}

// Miniatura de un tema en Ajustes › Apariencia.
component ThemeCard inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <color> bg;
    in property <color> pan;
    in property <color> bd;
    in property <length> rad;
    in property <bool> selected;
    callback picked();
    accessible-role: button;
    accessible-label: title;
    height: 150px;
    preferred-width: 0px;
    horizontal-stretch: 1;
    border-radius: Theme.r2 + 4px;
    border-width: 2px;
    border-color: selected ? Theme.accent : transparent;
    background: Theme.panel2;
    VerticalLayout {
        padding: 10px;
        spacing: 6px;
        Rectangle {
            height: 80px;
            border-radius: 10px;
            background: root.bg;
            border-width: 1px;
            border-color: #7f7f7f4d;
            clip: true;
            Rectangle {
                x: 8px; y: 8px; width: parent.width * 0.3; height: parent.height - 16px;
                border-radius: root.rad; background: root.pan; border-width: 1px; border-color: root.bd;
            }
            Rectangle {
                x: parent.width * 0.42; y: 8px; width: parent.width * 0.58 - 8px; height: 18px;
                border-radius: root.rad; background: root.pan; border-width: 1px; border-color: root.bd;
            }
            Rectangle {
                x: parent.width * 0.42; y: 34px; width: parent.width * 0.58 - 8px; height: 18px;
                border-radius: root.rad; background: root.pan; border-width: 1px; border-color: root.bd;
            }
            Rectangle {
                x: parent.width * 0.42; y: 60px; width: parent.width * 0.3; height: 6px;
                border-radius: 3px; background: Theme.accent;
            }
        }
        Text { text: root.title; font-size: 13px * Theme.fscale; font-weight: 600; color: Theme.text; }
        Text { text: root.subtitle; font-size: 12px * Theme.fscale; color: Theme.muted; }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.picked(); }
    }
}

component Swatch inherits Rectangle {
    in property <color> c;
    in property <string> name;
    in property <bool> selected;
    callback picked();
    accessible-role: button;
    accessible-label: name;
    width: 32px;
    height: 32px;
    border-radius: 16px;
    background: c;
    border-width: selected ? 3px : 1px;
    border-color: selected ? Theme.text : Theme.rim;
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.picked(); }
    }
}

component TabBtn inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    in property <int> badge: 0;
    callback clicked();
    accessible-role: tab;
    accessible-label: text;
    height: 38px;
    border-radius: Theme.r2;
    border-width: active ? Theme.lw : 0px;
    border-color: Theme.rim;
    background: active ? Theme.panel2 : tabta.has-hover ? Theme.hover : transparent;
    animate background { duration: 90ms; }
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 8px;
        Text {
            text: root.text;
            font-size: 14px * Theme.fscale;
            font-weight: 600;
            color: active ? Theme.text : Theme.muted;
            vertical-alignment: center;
        }
        if badge > 0: Rectangle {
            y: (parent.height - 18px) / 2;
            height: 18px;
            min-width: 22px;
            border-radius: 9px;
            background: Theme.accent;
            HorizontalLayout {
                padding-left: 7px;
                padding-right: 7px;
                Text {
                    text: badge;
                    font-size: 11px * Theme.fscale;
                    font-weight: 700;
                    color: Theme.on-accent;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
            }
        }
    }
    tabta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// ------------------------------------------------------------ Ventana ----

// Desplegable propio (mismo aspecto que el resto de botones). Misma
// interfaz que el ComboBox estándar: `model`, `current-index`, `selected`.
component ComboBox inherits Rectangle {
    in property <[string]> model;
    in-out property <int> current-index: 0;
    in property <bool> enabled: true;
    callback selected(string);
    height: Theme.compact ? 30px : 34px;
    min-width: 110px;
    border-radius: Theme.r2;
    border-width: Theme.lw;
    border-color: Theme.rim;
    background: touch.has-hover ? Theme.head : Theme.panel2;
    opacity: enabled ? 1 : 0.45;
    accessible-role: combobox;
    accessible-label: root.model[root.current-index];
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 8px;
        spacing: 6px;
        Text {
            horizontal-stretch: 1;
            text: root.model[root.current-index];
            font-size: Theme.font;
            color: Theme.text;
            vertical-alignment: center;
            overflow: elide;
        }
        VerticalLayout {
            alignment: center;
            Icon { size: 14px; commands: "M6 9l6 6 6-6"; ink: Theme.muted; }
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { menu.show(); }
    }
    menu := PopupWindow {
        x: 0px;
        y: root.height + 2px;
        width: max(root.width, 140px);
        Rectangle {
            background: Theme.menu-bg;
            border-radius: Theme.r2;
            border-width: 1px;
            border-color: Theme.rim;
            drop-shadow-blur: 14px;
            drop-shadow-color: Theme.shadow;
            VerticalLayout {
                padding: 4px;
                spacing: 1px;
                for m[i] in root.model: Rectangle {
                    height: 30px;
                    border-radius: 6px;
                    background: ta.has-hover ? Theme.selbg : transparent;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 6px;
                        Text {
                            horizontal-stretch: 1;
                            text: m;
                            font-size: Theme.font;
                            font-weight: i == root.current-index ? 700 : 400;
                            color: Theme.text;
                            vertical-alignment: center;
                        }
                        if i == root.current-index: VerticalLayout {
                            alignment: center;
                            Icon { size: 12px; commands: "M5 12l5 5 9-10"; ink: Theme.accent; stroke-width: 3px; }
                        }
                    }
                    ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.current-index = i;
                            root.selected(m);
                        }
                    }
                }
            }
        }
    }
}

// Selector numérico propio, con − y +. Misma interfaz que el SpinBox
// estándar: `value`, `minimum`, `maximum`.
component SpinBox inherits Rectangle {
    in-out property <int> value: 0;
    in property <int> minimum: 0;
    in property <int> maximum: 100;
    in property <bool> enabled: true;
    callback edited(int);
    height: Theme.compact ? 30px : 34px;
    min-width: 90px;
    border-radius: Theme.r2;
    border-width: Theme.lw;
    border-color: Theme.rim;
    background: Theme.panel2;
    opacity: enabled ? 1 : 0.45;
    accessible-role: spinbox;
    accessible-value: root.value;
    HorizontalLayout {
        Rectangle {
            width: 30px;
            background: minus.has-hover ? Theme.head : transparent;
            border-radius: Theme.r2;
            Icon { size: 12px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; commands: "M5 12h14"; ink: root.value > root.minimum ? Theme.text : Theme.muted; }
            minus := TouchArea {
                enabled: root.enabled && root.value > root.minimum;
                mouse-cursor: pointer;
                clicked => { root.value = max(root.minimum, root.value - 1); root.edited(root.value); }
            }
        }
        Text {
            horizontal-stretch: 1;
            text: root.value;
            font-size: Theme.font;
            color: Theme.text;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        Rectangle {
            width: 30px;
            background: plus.has-hover ? Theme.head : transparent;
            border-radius: Theme.r2;
            Icon { size: 12px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; commands: "M12 5v14M5 12h14"; ink: root.value < root.maximum ? Theme.text : Theme.muted; }
            plus := TouchArea {
                enabled: root.enabled && root.value < root.maximum;
                mouse-cursor: pointer;
                clicked => { root.value = min(root.maximum, root.value + 1); root.edited(root.value); }
            }
        }
    }
}

// Borde que se arrastra para cambiar el ancho de un panel. `dragged` da lo
// que se arrastró desde el último aviso (ya incluido en el ancho actual).
component Splitter inherits Rectangle {
    callback dragged(length);
    width: 8px;
    Rectangle {
        x: (parent.width - self.width) / 2;
        width: 3px;
        border-radius: 2px;
        background: ta.has-hover || ta.pressed ? Theme.accent.with-alpha(0.6) : transparent;
    }
    ta := TouchArea {
        mouse-cursor: ew-resize;
        moved => {
            if self.pressed {
                root.dragged(self.mouse-x - self.pressed-x);
            }
        }
    }
}

// Botón de la barra de título (minimizar, maximizar, cerrar).
component WinBtn inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> danger: false;
    callback clicked();
    width: 46px;
    accessible-role: button;
    accessible-label: label;
    accessible-action-default => { clicked(); }
    background: ta.pressed ? (danger ? #c93a3f : Theme.press) : ta.has-hover ? (danger ? #e5484d : Theme.text.with-alpha(0.14)) : transparent;
    animate background { duration: 80ms; }
    Icon {
        size: 14px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        commands: icon;
        ink: danger && ta.has-hover ? #ffffff : Theme.text;
        stroke-width: 1.8px;
    }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// Barra de título propia: arrastra la ventana, doble clic maximiza.
component TitleBar inherits Rectangle {
    in property <bool> maximized;
    in property <string> title-text: "OmniLoad";
    callback drag();
    callback minimize();
    callback toggle-maximize();
    callback close();
    height: 36px;
    background: Theme.bar;
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.bar-line;
    }
    drag-area := TouchArea {
        double-clicked => { root.toggle-maximize(); }
        pointer-event(e) => {
            if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                root.drag();
            }
        }
    }
    HorizontalLayout {
        padding-left: 12px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            Image { width: 18px; height: 18px; source: @image-url("icon.png"); image-fit: contain; }
        }
        Text { text: root.title-text; font-size: 12px * Theme.fscale; color: Theme.muted; vertical-alignment: center; }
        Rectangle { horizontal-stretch: 1; }
        WinBtn { icon: "M5 12h14"; label: "Minimizar"; clicked => { root.minimize(); } }
        WinBtn {
            icon: root.maximized ? "M8 8h11v11H8zM5 15V5h10" : "M5 5h14v14H5z";
            label: root.maximized ? "Restaurar" : "Maximizar";
            clicked => { root.toggle-maximize(); }
        }
        WinBtn { icon: "M6 6l12 12M18 6L6 18"; label: "Cerrar"; danger: true; clicked => { root.close(); } }
    }
}

// Zona de 6 px en un borde o esquina para cambiar el tamaño arrastrando.
component ResizeEdge inherits TouchArea {
    in property <int> edge;
    callback start(int);
    pointer-event(e) => {
        if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
            root.start(root.edge);
        }
    }
}

export component AppWindow inherits Window {
    title: "OmniLoad";
    icon: @image-url("icon.png");
    no-frame: true;
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 1100px;
    min-height: 560px;
    background: Theme.wall;
    default-font-family: "Inter";
    default-font-size: Theme.font;

    // 0 Descargas, 1 Capturador de enlaces, 2 Ajustes.
    in-out property <int> tab: 0;
    in-out property <int> settings-section: 1;
    in property <string> message;
    in property <bool> message-is-error;

    // Ajustes que se guardan.
    in-out property <int> properties-panel: 0;
    // Anchos que se cambian arrastrando (panel de propiedades a la derecha, lista de Ajustes).
    in-out property <length> side-w: 320px;
    in-out property <length> nav-w: 240px;
    in-out property <int> max-active: 3;
    in-out property <int> connections: 8;
    // Límite de velocidad: se escribe o se elige de la lista.
    in-out property <string> speed-text: "Sin límite";
    in-out property <bool> speed-editing;
    callback speed-text-accepted(string);
    callback speed-preset(int);
    // Barra de título propia.
    in property <bool> maximized: false;
    callback win-drag();
    callback win-minimize();
    callback win-toggle-maximize();
    callback win-close();
    callback win-resize(int);
    callback col-toggle(int);
    callback col-move(int, int);
    callback col-reset();
    in-out property <int> max-per-server: 8;
    in-out property <bool> keep-downloading: false;
    in-out property <bool> close-to-tray: true;
    in-out property <bool> minimize-to-tray: true;
    in-out property <bool> notify-done: true;
    // Hay icono en la bandeja del sistema.
    in property <bool> tray-available: false;
    // Versión y aviso de versión nueva.
    in property <string> app-version;
    // Número del PR si esta compilación es de un PR sin aprobar (0 = versión normal).
    in property <int> app-pr: 0;
    // 0 sin comprobar, 1 comprobando, 2 al día, 3 hay una nueva, 4 aún no hay
    // versiones publicadas, 5 error.
    in property <int> update-state: 0;
    in property <string> update-text;
    in-out property <bool> check-updates: true;
    // Automático: horario, reglas por tipo, acción al terminar, inicio con el sistema.
    in-out property <bool> schedule-enabled: false;
    // Días del horario: bit 0 lunes … bit 6 domingo.
    in-out property <int> schedule-days: 127;
    in property <[bool]> schedule-day-on: [true, true, true, true, true, true, true];
    in-out property <string> schedule-from: "00:00";
    in-out property <string> schedule-to: "07:00";
    in property <bool> schedule-error: false;
    callback schedule-day-toggled(int);
    in-out property <[RuleRow]> rules;
    callback rule-add();
    callback rule-remove(int);
    callback rule-exts-edited(int, string);
    callback rule-choose(int);
    // 0 nada, 1 cerrar OmniLoad, 2 suspender, 3 apagar.
    in-out property <int> finish-action: 0;
    in-out property <bool> autostart: false;
    // Escala de la interfaz: 0 automática, 1 100 %, 2 125 %… (al reabrir).
    in-out property <int> ui-scale: 0;
    // Cuenta atrás de la acción al terminar (vacío = no hay).
    in property <string> finish-text;
    callback finish-cancel();
    callback check-updates-now();
    callback open-release();
    in-out property <bool> watch-clipboard: true;
    in-out property <int> clip-popup: 1;
    in-out property <bool> package-folders: true;
    in-out property <bool> single-file-folders: true;
    in-out property <bool> clip-autoclose: true;
    in-out property <string> download-dir;

    // Cabecera.
    in property <string> header-speed;
    in property <string> speed-path: "M 0 28 L 140 28";

    // Descargas.
    in property <[DlRow]> downloads;
    in property <[Stat]> totals;
    in property <string> net-text;
    // Panel de propiedades: 0 nada, 1 paquete, 2 archivo.
    in property <int> sel-kind;
    in property <string> sel-title;
    in property <[Stat]> sel-lines;
    in property <int> sel-priority: 1;
    in property <bool> sel-can-start;
    in property <bool> sel-can-stop;

    // Capturador.
    in property <[GrabTreeRow]> grabbed;
    in property <int> grab-count;
    in property <int> grab-selected-count;
    in property <int> grab-offline-count;
    in property <string> grab-summary;
    in property <bool> pkg-selected;
    in property <string> pkg-title;
    in-out property <string> pkg-name-text;
    in-out property <string> pkg-folder-text;
    in property <int> pkg-priority: 1;

    // Diálogo "Añadir enlaces".
    in-out property <bool> add-dialog-open: false;
    in-out property <string> add-dialog-text;

    callback add-links(string);
    callback add-links-file();
    callback dl-click(int, bool);
    callback dl-toggle(int);
    callback dl-search(string);
    callback start-all();
    callback pause-all();
    callback stop-all();
    callback queue-settings-changed();
    callback sel-start();
    callback sel-stop();
    // Quitar la selección de Descargas; con `true` también borra los archivos.
    callback sel-remove(bool);
    in-out property <bool> remove-dialog-open: false;
    callback change-sel-priority(int);
    callback sel-open-folder();

    callback grab-click(int, bool);
    callback grab-toggle(int);
    callback grab-check(int, bool, bool);
    callback grab-select-all(bool);
    callback grab-remove-offline();
    callback grab-recheck();
    callback grab-clear();
    callback grab-search(string);
    // true = "Iniciar descargas"; false = "Añadir a descargas".
    callback grab-to-downloads(bool);
    callback pkg-rename(string);
    callback pkg-folder(string);
    callback pkg-choose-folder();
    callback change-pkg-priority(int);
    callback pkg-remove();

    callback settings-changed();
    callback choose-download-dir();

    private property <[string]> priorities: ["Alta", "Normal", "Baja"];
    private property <bool> theme-dark: Theme.dark;
    changed theme-dark => { Palette.color-scheme = Theme.dark ? ColorScheme.dark : ColorScheme.light; }
    changed max-active => { queue-settings-changed(); }
    changed connections => { queue-settings-changed(); }
    changed max-per-server => { queue-settings-changed(); }
    changed watch-clipboard => { settings-changed(); }
    init => {
        Theme.system-dark = Palette.color-scheme == ColorScheme.dark;
        Palette.color-scheme = Theme.dark ? ColorScheme.dark : ColorScheme.light;
    }

    // Fondo: dos manchas de color muy suaves que se ven a través del cristal.
    if Theme.glass: Rectangle {
        x: root.width * 0.15 - self.width / 2;
        y: root.height * 0.2 - self.height / 2;
        width: root.width * 0.9;
        height: self.width;
        background: @radial-gradient(circle, Theme.blob1 0%, transparent 50%);
    }
    if Theme.glass: Rectangle {
        x: root.width * 0.85 - self.width / 2;
        y: root.height * 0.85 - self.height / 2;
        width: root.width * 0.9;
        height: self.width;
        background: @radial-gradient(circle, Theme.blob2 0%, transparent 50%);
    }

    VerticalLayout {
        padding: 14px;
        padding-top: 14px + 36px;
        spacing: 10px;

        // ---- Cabecera ----
        Panel {
            height: 52px;
            HorizontalLayout {
                padding: 7px;
                padding-left: 12px;
                spacing: 6px;
                // Dentro de un HorizontalLayout la `y` se ignora: el logo va en un
                // VerticalLayout que lo centra.
                VerticalLayout {
                    alignment: center;
                    Image {
                        width: 26px;
                        height: 26px;
                        source: @image-url("icon.png");
                        image-fit: contain;
                        accessible-role: image;
                        accessible-label: "OmniLoad";
                    }
                }
                Text {
                    text: "OmniLoad";
                    font-size: 15px * Theme.fscale;
                    font-weight: 700;
                    color: Theme.text;
                    vertical-alignment: center;
                }
                Rectangle { width: 12px; }
                TabBtn {
                    text: "Descargas";
                    active: root.tab == 0;
                    clicked => { root.tab = 0; }
                }
                TabBtn {
                    text: "Capturador de enlaces";
                    active: root.tab == 1;
                    badge: root.grab-count;
                    clicked => { root.tab = 1; }
                }
                Rectangle { horizontal-stretch: 1; }
                VerticalLayout { alignment: center; Path {
                    width: 140px;
                    height: 30px;
                    viewbox-width: 140;
                    viewbox-height: 30;
                    commands: root.speed-path;
                    opacity: root.header-speed == "" ? 0 : 1;
                    stroke: Theme.accent;
                    stroke-width: 2px;
                    fill: transparent;
                    accessible-role: image;
                    accessible-label: "Velocidad de los últimos 60 segundos";
                } }
                Text {
                    text: root.header-speed;
                    min-width: 90px;
                    font-size: 13px * Theme.fscale;
                    font-weight: 700;
                    color: Theme.text;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
                if root.update-state == 3: Btn {
                    y: (parent.height - self.height) / 2;
                    text: "Hay una versión nueva";
                    icon: "M12 5v10M7 11l5 5 5-5M5 19h14";
                    icon-color: Theme.ok;
                    label: root.update-text;
                    clicked => { root.settings-section = 2; root.tab = 2; }
                }
                VerticalLayout { alignment: center;
                Btn {
                    text: "Ajustes";
                    icon: "M4 21v-7M4 10V3M12 21v-9M12 8V3M20 21v-5M20 12V3M1 14h6M9 8h6M17 16h6";
                    primary: root.tab == 2;
                    clicked => { root.tab = root.tab == 2 ? 0 : 2; }
                }
                }
            }
        }

        if root.finish-text != "": Panel {
            HorizontalLayout {
                padding: 10px;
                spacing: 12px;
                Text {
                    horizontal-stretch: 1;
                    text: root.finish-text;
                    wrap: word-wrap;
                    font-size: 13px * Theme.fscale;
                    font-weight: 600;
                    color: Theme.warn;
                    vertical-alignment: center;
                }
                Btn { text: "Cancelar"; primary: true; clicked => { root.finish-cancel(); } }
            }
        }

        if root.message != "": Text {
            text: root.message;
            wrap: word-wrap;
            font-size: 13px * Theme.fscale;
            color: root.message-is-error ? Theme.err : Theme.muted;
        }

        // ---- Descargas ----
        if root.tab == 0: VerticalLayout {
            vertical-stretch: 1;
            spacing: 10px;

            // Barra de controles, encima de la lista.
            Panel {
                HorizontalLayout {
                    padding: 8px;
                    spacing: 6px;
                    Btn {
                        text: "Añadir enlaces";
                        icon: "M12 5v14M5 12h14";
                        primary: true;
                        clicked => { root.add-dialog-open = true; }
                    }
                    Sep { y: (parent.height - self.height) / 2; }
                    Btn {
                        label: "Iniciar descargas";
                        icon: "M7 4l13 8-13 8z";
                        icon-filled: true;
                        icon-color: Theme.ok;
                        clicked => { root.start-all(); }
                    }
                    Btn {
                        label: "Pausar descargas";
                        icon: "M9 5v14M15 5v14";
                        clicked => { root.pause-all(); }
                    }
                    Btn {
                        label: "Detener descargas";
                        icon: "M5 5h14v14H5z";
                        icon-filled: true;
                        icon-color: Theme.err;
                        clicked => { root.stop-all(); }
                    }
                    Sep { y: (parent.height - self.height) / 2; }
                    Text { text: "Simultáneas"; color: Theme.text; vertical-alignment: center; }
                    SpinBox {
                        width: 90px;
                        minimum: 1;
                        maximum: 20;
                        value <=> root.max-active;
                    }
                    Text { text: "Conexiones por archivo"; color: Theme.text; vertical-alignment: center; }
                    SpinBox {
                        width: 90px;
                        minimum: 1;
                        maximum: 32;
                        value <=> root.connections;
                    }
                    Text { text: "Límite"; color: Theme.text; vertical-alignment: center; }
                    LineEdit {
                        changed has-focus => { root.speed-editing = self.has-focus; }
                        width: 100px;
                        text <=> root.speed-text;
                        placeholder-text: "700 KB/s";
                        accepted => { root.speed-text-accepted(self.text); }
                    }
                    Btn {
                        label: "Límites habituales";
                        icon: "M6 9l6 6 6-6";
                        clicked => { speed-menu.show(); }
                        speed-menu := PopupWindow {
                            x: 0px;
                            y: parent.height + 2px;
                            width: 120px;
                            Rectangle {
                                background: Theme.menu-bg;
                                border-radius: Theme.r2;
                                border-width: 1px;
                                border-color: Theme.rim;
                                VerticalLayout {
                                    padding: 4px;
                                    // Mismo orden que SPEED_LIMITS en settings.rs.
                                    for l[i] in ["Sin límite", "256 KB/s", "512 KB/s", "1 MB/s", "2 MB/s", "5 MB/s", "10 MB/s", "20 MB/s", "50 MB/s", "100 MB/s"]: Rectangle {
                                        height: 28px;
                                        background: ta.has-hover ? Theme.selbg : transparent;
                                        border-radius: 6px;
                                        Text { x: 8px; text: l; color: Theme.text; vertical-alignment: center; }
                                        ta := TouchArea { clicked => { root.speed-preset(i); } }
                                    }
                                }
                            }
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    ColsMenu {
                        cols: DlCols.cols;
                        toggle(i) => { root.col-toggle(i); }
                        move(i, d) => { root.col-move(i, d); }
                        reset => { root.col-reset(); }
                    }
                    LineEdit {
                        // Se encoge antes de salirse de la barra en ventanas estrechas.
                        preferred-width: 240px;
                        min-width: 110px;
                        horizontal-stretch: 0;
                        placeholder-text: "Buscar paquetes o archivos";
                        clearable: true;
                        edited(t) => { root.dl-search(t); }
                    }
                }
            }

            HorizontalLayout {
                vertical-stretch: 1;
                spacing: 10px;
                Panel {
                    horizontal-stretch: 1;
                    min-width: 0px;
                    clip: true;
                    VerticalLayout {
                        ColsHeader {
                            cols: DlCols.cols;
                            resize(i, w) => { DlCols.resize(i, w); }
                            resize-done => { DlCols.resize-done(); }
                            reorder(a, b) => { DlCols.reorder(a, b); }
                        }
                        if root.downloads.length == 0: Rectangle {
                            vertical-stretch: 1;
                            Text {
                                text: "Aún no hay descargas.\nPulsa «Añadir enlaces» y elige qué bajar en el Capturador de enlaces.";
                                horizontal-alignment: center;
                                color: Theme.muted;
                            }
                        }
                        if root.downloads.length > 0: ListView {
                            vertical-stretch: 1;
                            for row in root.downloads: DlLine {
                                item: row;
                                cols: DlCols.cols;
                                clicked => { root.dl-click(row.key, row.is-package); }
                                toggle => { root.dl-toggle(row.key); }
                            }
                        }
                    }
                }
                if root.properties-panel == 1 && root.sel-kind > 0: Splitter {
                    dragged(d) => { root.side-w = clamp(root.side-w - d, 240px, 720px); }
                }
                if root.properties-panel == 1 && root.sel-kind > 0: Panel {
                    width: root.side-w;
                    VerticalLayout {
                        padding: 16px;
                        spacing: 10px;
                        Text {
                            text: root.sel-title;
                            font-size: 14px * Theme.fscale;
                            font-weight: 700;
                            color: Theme.text;
                            wrap: word-wrap;
                        }
                        for l in root.sel-lines: VerticalLayout {
                            spacing: 2px;
                            FieldLabel { text: l.label; }
                            Text { text: l.value; color: Theme.text; font-size: 13px * Theme.fscale; wrap: word-wrap; }
                        }
                        FieldLabel { text: "Prioridad"; }
                        ComboBox {
                            model: root.priorities;
                            current-index: root.sel-priority;
                            selected => { root.change-sel-priority(self.current-index); }
                        }
                        HorizontalLayout {
                            spacing: 6px;
                            if root.sel-can-start: Btn {
                                text: "Iniciar";
                                icon: "M7 4l13 8-13 8z";
                                icon-filled: true;
                                icon-color: Theme.ok;
                                clicked => { root.sel-start(); }
                            }
                            if root.sel-can-stop: Btn {
                                text: "Detener";
                                icon: "M5 5h14v14H5z";
                                icon-filled: true;
                                icon-color: Theme.err;
                                clicked => { root.sel-stop(); }
                            }
                        }
                        HorizontalLayout {
                            spacing: 6px;
                            Btn { text: "Abrir carpeta"; clicked => { root.sel-open-folder(); } }
                            Btn { text: "Quitar"; clicked => { root.remove-dialog-open = true; } }
                        }
                        Rectangle { vertical-stretch: 1; }
                    }
                }
            }

            if root.properties-panel == 0 && root.sel-kind > 0: Panel {
                VerticalLayout {
                    padding: 12px;
                    padding-left: 16px;
                    padding-right: 16px;
                    spacing: 10px;
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: (root.sel-kind == 1 ? "Paquete: " : "Archivo: ") + root.sel-title;
                            font-size: 13px * Theme.fscale;
                            font-weight: 700;
                            color: Theme.text;
                            overflow: elide;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }
                        if root.sel-can-start: Btn {
                            text: "Iniciar";
                            icon: "M7 4l13 8-13 8z";
                            icon-filled: true;
                            icon-color: Theme.ok;
                            clicked => { root.sel-start(); }
                        }
                        if root.sel-can-stop: Btn {
                            text: "Detener";
                            icon: "M5 5h14v14H5z";
                            icon-filled: true;
                            icon-color: Theme.err;
                            clicked => { root.sel-stop(); }
                        }
                        ComboBox {
                            width: 120px;
                            model: root.priorities;
                            current-index: root.sel-priority;
                            selected => { root.change-sel-priority(self.current-index); }
                        }
                        Btn { text: "Abrir carpeta"; clicked => { root.sel-open-folder(); } }
                        Btn { text: "Quitar"; clicked => { root.remove-dialog-open = true; } }
                    }
                    HorizontalLayout {
                        spacing: 24px;
                        for l in root.sel-lines: VerticalLayout {
                            spacing: 2px;
                            horizontal-stretch: l.label == "Enlace" || l.label == "Carpeta" || l.label == "Detalle" ? 2 : 1;
                            FieldLabel { text: l.label; }
                            Text { text: l.value; color: Theme.text; font-size: 13px * Theme.fscale; overflow: elide; }
                        }
                    }
                }
            }

            // Resumen.
            Panel {
                HorizontalLayout {
                    padding: 10px;
                    padding-left: 16px;
                    padding-right: 16px;
                    spacing: 24px;
                    for t in root.totals: VerticalLayout {
                        spacing: 2px;
                        Text { text: t.label; font-size: 12px * Theme.fscale; color: Theme.muted; }
                        Text { text: t.value; font-size: 14px * Theme.fscale; font-weight: 700; color: Theme.text; }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        min-width: 200px;
                        spacing: 4px;
                        Text { text: "Redes en uso"; font-size: 12px * Theme.fscale; color: Theme.muted; }
                        Rectangle {
                            height: 14px;
                            border-radius: 5px;
                            background: Theme.track;
                            clip: true;
                            Rectangle {
                                x: 0;
                                width: root.header-speed == "" ? 0px : parent.width;
                                background: Theme.accent;
                            }
                        }
                        Text { text: root.net-text; font-size: 12.5px * Theme.fscale; color: Theme.text; }
                    }
                }
            }
        }

        // ---- Capturador de enlaces ----
        if root.tab == 1: VerticalLayout {
            vertical-stretch: 1;
            spacing: 10px;

            HorizontalLayout {
                vertical-stretch: 1;
                spacing: 10px;
                Panel {
                    horizontal-stretch: 1;
                    min-width: 0px;
                    clip: true;
                    VerticalLayout {
                        ColsHeader {
                            cols: GrabCols.cols;
                            resize(i, w) => { GrabCols.resize(i, w); }
                            resize-done => { GrabCols.resize-done(); }
                            reorder(a, b) => { GrabCols.reorder(a, b); }
                        }
                        if root.grabbed.length == 0: Rectangle {
                            vertical-stretch: 1;
                            Text {
                                text: "Pulsa «Añadir enlaces» o copia un enlace.\nAquí verás los archivos que contiene, agrupados en paquetes, antes de descargar nada.";
                                horizontal-alignment: center;
                                color: Theme.muted;
                            }
                        }
                        if root.grabbed.length > 0: ListView {
                            vertical-stretch: 1;
                            for row in root.grabbed: GrabLine {
                                item: row;
                                cols: GrabCols.cols;
                                clicked => { root.grab-click(row.key, row.is-package); }
                                toggle => { root.grab-toggle(row.key); }
                                check(v) => { root.grab-check(row.key, row.is-package, v); }
                            }
                        }
                    }
                }
                if root.properties-panel == 1 && root.pkg-selected: Splitter {
                    dragged(d) => { root.side-w = clamp(root.side-w - d, 240px, 720px); }
                }
                if root.properties-panel == 1 && root.pkg-selected: Panel {
                    width: root.side-w;
                    VerticalLayout {
                        padding: 16px;
                        spacing: 8px;
                        Text {
                            text: "Propiedades del paquete";
                            font-size: 14px * Theme.fscale;
                            font-weight: 700;
                            color: Theme.text;
                        }
                        FieldLabel { text: "Nombre del paquete"; }
                        LineEdit {
                            text <=> root.pkg-name-text;
                            edited(t) => { root.pkg-rename(t); }
                        }
                        FieldLabel { text: "Guardar en"; }
                        LineEdit {
                            text <=> root.pkg-folder-text;
                            edited(t) => { root.pkg-folder(t); }
                        }
                        Btn { text: "Elegir carpeta…"; clicked => { root.pkg-choose-folder(); } }
                        FieldLabel { text: "Prioridad"; }
                        ComboBox {
                            model: root.priorities;
                            current-index: root.pkg-priority;
                            selected => { root.change-pkg-priority(self.current-index); }
                        }
                        Btn { text: "Quitar paquete"; clicked => { root.pkg-remove(); } }
                        Rectangle { vertical-stretch: 1; }
                    }
                }
            }

            if root.properties-panel == 0 && root.pkg-selected: Panel {
                VerticalLayout {
                    padding: 12px;
                    padding-left: 16px;
                    padding-right: 16px;
                    spacing: 10px;
                    Text {
                        text: "Propiedades del paquete: " + root.pkg-title;
                        font-size: 13px * Theme.fscale;
                        font-weight: 700;
                        color: Theme.text;
                        overflow: elide;
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 4px;
                            FieldLabel { text: "Nombre del paquete"; }
                            LineEdit {
                                text <=> root.pkg-name-text;
                                edited(t) => { root.pkg-rename(t); }
                            }
                        }
                        VerticalLayout {
                            horizontal-stretch: 2;
                            spacing: 4px;
                            FieldLabel { text: "Guardar en"; }
                            HorizontalLayout {
                                spacing: 6px;
                                LineEdit {
                                    text <=> root.pkg-folder-text;
                                    edited(t) => { root.pkg-folder(t); }
                                }
                                Btn { text: "Elegir…"; clicked => { root.pkg-choose-folder(); } }
                            }
                        }
                        VerticalLayout {
                            width: 140px;
                            spacing: 4px;
                            FieldLabel { text: "Prioridad"; }
                            ComboBox {
                                model: root.priorities;
                                current-index: root.pkg-priority;
                                selected => { root.change-pkg-priority(self.current-index); }
                            }
                        }
                        VerticalLayout {
                            alignment: end;
                            Btn { text: "Quitar paquete"; clicked => { root.pkg-remove(); } }
                        }
                    }
                }
            }

            Panel {
                HorizontalLayout {
                    padding: 8px;
                    spacing: 6px;
                    Btn {
                        text: "Añadir enlaces";
                        icon: "M12 5v14M5 12h14";
                        clicked => { root.add-dialog-open = true; }
                    }
                    Btn { text: "Todos"; clicked => { root.grab-select-all(true); } }
                    Btn { text: "Ninguno"; clicked => { root.grab-select-all(false); } }
                    if root.grab-offline-count > 0: Btn {
                        text: "Reintentar caídos";
                        clicked => { root.grab-recheck(); }
                    }
                    Btn { text: "Quitar caídos"; clicked => { root.grab-remove-offline(); } }
                    Btn { text: "Vaciar"; clicked => { root.grab-clear(); } }
                    LineEdit {
                        width: 120px;
                        placeholder-text: "Buscar";
                        edited(t) => { root.grab-search(t); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Text {
                        text: root.grab-summary;
                        color: Theme.muted;
                        vertical-alignment: center;
                    }
                    Btn {
                        text: "Añadir a descargas";
                        enabled: root.grab-selected-count > 0;
                        clicked => { root.grab-to-downloads(false); }
                    }
                    Btn {
                        text: "Iniciar descargas";
                        icon: "M7 4l13 8-13 8z";
                        icon-filled: true;
                        primary: true;
                        enabled: root.grab-selected-count > 0;
                        clicked => { root.grab-to-downloads(true); }
                    }
                }
            }
        }

        // ---- Ajustes ----
        if root.tab == 2: HorizontalLayout {
            vertical-stretch: 1;
            spacing: 0px;
            Panel {
                width: root.nav-w;
                VerticalLayout {
                    padding: 16px;
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 2px;
                    alignment: start;
                    Text {
                        text: "Ajustes";
                        font-size: 20px * Theme.fscale;
                        font-weight: 700;
                        color: Theme.text;
                    }
                    Rectangle { height: 12px; }
                    for s[i] in ["General", "Apariencia", "Versión", "Automático"]: Rectangle {
                        height: 40px;
                        border-radius: Theme.r2;
                        background: i == root.settings-section ? Theme.panel2 : transparent;
                        border-width: i == root.settings-section ? Theme.lw : 0px;
                        border-color: Theme.rim;
                        accessible-role: button;
                        accessible-label: s;
                        Text {
                            x: 12px;
                            text: s;
                            font-size: 13px * Theme.fscale;
                            font-weight: 600;
                            color: Theme.text;
                            vertical-alignment: center;
                        }
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.settings-section = i; }
                        }
                    }
                }
            }

            Splitter {
                width: 16px;
                dragged(d) => { root.nav-w = clamp(root.nav-w + d, 180px, 420px); }
            }
            Panel {
                horizontal-stretch: 1;
                if root.settings-section == 0: general := ScrollView {
                  VerticalLayout {
                    width: general.visible-width;
                    padding: 28px;
                    spacing: 6px;
                    alignment: start;
                    Text { text: "General"; font-size: 28px * Theme.fscale; font-weight: 700; color: Theme.text; }
                    SettingRow {
                        title: "Carpeta de descargas";
                        subtitle: "Donde se guarda todo lo que descargas.";
                        LineEdit {
                            width: 360px;
                            text <=> root.download-dir;
                            accepted => { root.settings-changed(); }
                        }
                        Btn { text: "Elegir…"; clicked => { root.choose-download-dir(); } }
                    }
                    SettingRow {
                        title: "Una carpeta por paquete";
                        subtitle: "Cada paquete va a una subcarpeta con su nombre (se quitan los caracteres que el sistema no admite). Se puede cambiar en el panel del paquete del Capturador.";
                        Check {
                            checked <=> root.package-folders;
                            label: "Una carpeta por paquete";
                            toggled => { root.settings-changed(); }
                        }
                    }
                    SettingRow {
                        title: "También para un solo archivo";
                        subtitle: "Si se desactiva, los paquetes de un archivo van directos a la carpeta de descargas.";
                        opacity: root.package-folders ? 1 : 0.5;
                        Check {
                            checked <=> root.single-file-folders;
                            enabled: root.package-folders;
                            label: "Carpeta también para paquetes de un solo archivo";
                            toggled => { root.settings-changed(); }
                        }
                    }
                    SettingRow {
                        title: "Conexiones por servidor";
                        subtitle: "Cuántas conexiones se abren como mucho a una misma web sumando todas las descargas (0 = sin tope). Si el servidor acepta menos, OmniLoad lo aprende solo y lo recuerda.";
                        SpinBox {
                            width: 90px;
                            minimum: 0;
                            maximum: 64;
                            value <=> root.max-per-server;
                        }
                    }
                    SettingRow {
                        title: "Cerrar a la bandeja";
                        subtitle: root.tray-available
                            ? "La X de la ventana la esconde junto al reloj y las descargas siguen. Para salir del todo: «Salir» en el menú del icono."
                            : "Este escritorio no tiene bandeja del sistema: cerrar la ventana sale de OmniLoad. En GNOME, instala la extensión «AppIndicator» para tenerla.";
                        opacity: root.tray-available ? 1 : 0.5;
                        Check {
                            checked <=> root.close-to-tray;
                            enabled: root.tray-available;
                            label: "Cerrar a la bandeja";
                            toggled => { root.settings-changed(); }
                        }
                    }
                    SettingRow {
                        title: "Minimizar a la bandeja";
                        subtitle: "Al minimizar, la ventana desaparece de la barra de tareas y queda solo el icono de la bandeja.";
                        opacity: root.tray-available ? 1 : 0.5;
                        Check {
                            checked <=> root.minimize-to-tray;
                            enabled: root.tray-available;
                            label: "Minimizar a la bandeja";
                            toggled => { root.settings-changed(); }
                        }
                    }
                    SettingRow {
                        title: "Avisar al terminar";
                        subtitle: "Una notificación del sistema cuando termina un archivo o un paquete entero, o si falla (solo si no estás mirando la ventana).";
                        Check {
                            checked <=> root.notify-done;
                            label: "Avisar al terminar";
                            toggled => { root.settings-changed(); }
                        }
                    }
                    SettingRow {
                        title: "Seguir descargando al salir";
                        subtitle: "Al salir de OmniLoad las descargas continúan en segundo plano. Al volver a abrirlo las verás tal cual. Desde la terminal: «omni service stop» para pararlas.";
                        Check {
                            checked <=> root.keep-downloading;
                            label: "Seguir descargando al salir";
                            toggled => { root.settings-changed(); }
                        }
                    }
                    SettingRow {
                        title: "Vigilar portapapeles";
                        subtitle: "Los enlaces que copies aparecen solos en el Capturador de enlaces.";
                        Check {
                            checked <=> root.watch-clipboard;
                            label: "Vigilar portapapeles";
                            toggled => { root.settings-changed(); }
                        }
                    }
                  }
                }

                if root.settings-section == 3: auto := ScrollView {
                  VerticalLayout {
                    width: auto.visible-width;
                    padding: 28px;
                    spacing: 6px;
                    alignment: start;
                    Text { text: "Automático"; font-size: 28px * Theme.fscale; font-weight: 700; color: Theme.text; }
                    SettingRow {
                        title: "Horario de descargas";
                        subtitle: "Solo descarga en los días y las horas que elijas. Fuera de ellas todo queda en pausa (con el progreso guardado) y sigue solo al llegar la hora. Si la hora de fin es menor que la de inicio, el tramo acaba al día siguiente (por ejemplo, de 23:00 a 07:00).";
                        Check {
                            checked <=> root.schedule-enabled;
                            label: "Usar horario";
                            toggled => { root.settings-changed(); }
                        }
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        opacity: root.schedule-enabled ? 1 : 0.5;
                        for d[i] in ["L", "M", "X", "J", "V", "S", "D"]: Rectangle {
                            width: 34px;
                            height: 34px;
                            border-radius: Theme.r2;
                            background: root.schedule-day-on[i] ? Theme.accent : Theme.panel2;
                            accessible-role: checkbox;
                            accessible-label: d;
                            Text {
                                text: d;
                                font-size: 13px * Theme.fscale;
                                font-weight: 600;
                                color: root.schedule-day-on[i] ? Theme.on-accent : Theme.text;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            TouchArea {
                                enabled: root.schedule-enabled;
                                mouse-cursor: pointer;
                                clicked => { root.schedule-day-toggled(i); }
                            }
                        }
                        Rectangle { width: 16px; }
                        Text { text: "De"; color: Theme.muted; font-size: 13px * Theme.fscale; vertical-alignment: center; }
                        LineEdit {
                            width: 80px;
                            enabled: root.schedule-enabled;
                            text <=> root.schedule-from;
                            placeholder-text: "00:00";
                            accepted => { root.settings-changed(); }
                        }
                        Text { text: "a"; color: Theme.muted; font-size: 13px * Theme.fscale; vertical-alignment: center; }
                        LineEdit {
                            width: 80px;
                            enabled: root.schedule-enabled;
                            text <=> root.schedule-to;
                            placeholder-text: "07:00";
                            accepted => { root.settings-changed(); }
                        }
                        Btn { text: "Aplicar"; enabled: root.schedule-enabled; clicked => { root.settings-changed(); } }
                    }
                    if root.schedule-error: Text {
                        text: "Escribe las horas como HH:MM, por ejemplo 23:30.";
                        color: Theme.err;
                        font-size: 13px * Theme.fscale;
                    }
                    SettingRow {
                        title: "Carpeta según el tipo de archivo";
                        subtitle: "Por ejemplo, vídeos a una carpeta y .zip a otra. Escribe las extensiones separadas por comas (mp4, mkv). Gana la primera regla que coincida; un paquete con carpeta propia no se toca.";
                        Btn { text: "Añadir regla"; icon: "M12 5v14M5 12h14"; clicked => { root.rule-add(); } }
                    }
                    for r[i] in root.rules: HorizontalLayout {
                        spacing: 8px;
                        height: 36px;
                        LineEdit {
                            width: 200px;
                            text: r.exts;
                            placeholder-text: "mp4, mkv, avi";
                            edited(t) => { root.rule-exts-edited(i, t); }
                            accepted => { root.settings-changed(); }
                        }
                        Text { text: "→"; color: Theme.muted; vertical-alignment: center; }
                        Text {
                            horizontal-stretch: 1;
                            text: r.folder == "" ? "(elige una carpeta)" : r.folder;
                            color: r.folder == "" ? Theme.muted : Theme.text;
                            overflow: elide;
                            vertical-alignment: center;
                            font-size: 13px * Theme.fscale;
                        }
                        Btn { text: "Elegir…"; clicked => { root.rule-choose(i); } }
                        Btn { text: "Quitar"; clicked => { root.rule-remove(i); } }
                    }
                    SettingRow {
                        title: "Al terminar todas las descargas";
                        subtitle: "Qué hacer cuando no queda nada por descargar. Suspender y apagar dan 60 segundos para cancelar con un aviso.";
                        ComboBox {
                            width: 200px;
                            model: ["No hacer nada", "Cerrar OmniLoad", "Suspender el equipo", "Apagar el equipo"];
                            current-index <=> root.finish-action;
                            selected => { root.settings-changed(); }
                        }
                    }
                    SettingRow {
                        title: "Iniciar con el sistema";
                        subtitle: "OmniLoad arranca al encender el equipo, escondido en la bandeja, y las descargas siguen sin que tengas que abrirlo.";
                        Check {
                            checked <=> root.autostart;
                            label: "Iniciar con el sistema";
                            toggled => { root.settings-changed(); }
                        }
                    }
                  }
                }

                if root.settings-section == 2: VerticalLayout {
                    padding: 28px;
                    spacing: 6px;
                    alignment: start;
                    Text { text: "Versión"; font-size: 28px * Theme.fscale; font-weight: 700; color: Theme.text; }
                    if root.app-pr > 0: Rectangle {
                        height: 44px;
                        border-radius: Theme.r2;
                        background: Theme.warn.with-alpha(0.14);
                        border-width: Theme.lw;
                        border-color: Theme.warn.with-alpha(0.5);
                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            spacing: 10px;
                            VerticalLayout {
                                alignment: center;
                                Icon { size: 16px; commands: "M12 9v4M12 17h.01M10.3 3.9L1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"; ink: Theme.warn; }
                            }
                            Text {
                                horizontal-stretch: 1;
                                text: "Versión del PR #" + root.app-pr + " sin aprobar: es una prueba, no una versión publicada.";
                                font-size: 13px * Theme.fscale;
                                font-weight: 600;
                                color: Theme.warn;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                    }
                    SettingRow {
                        title: "OmniLoad " + root.app-version + (root.app-pr > 0 ? " · PR #" + root.app-pr : "");
                        subtitle: root.update-text;
                        if root.update-state == 3: Btn {
                            text: "Ver la versión nueva";
                            primary: true;
                            icon: "M12 5v10M7 11l5 5 5-5M5 19h14";
                            clicked => { root.open-release(); }
                        }
                        Btn {
                            text: root.update-state == 1 ? "Comprobando…" : "Buscar actualizaciones";
                            enabled: root.update-state != 1;
                            clicked => { root.check-updates-now(); }
                        }
                    }
                    SettingRow {
                        title: "Buscar al abrir";
                        subtitle: "Al abrir OmniLoad pregunta a GitHub cuál es la última versión y te avisa si hay una nueva. No descarga ni instala nada: tú decides si actualizas. Solo envía el nombre y el número de versión del programa.";
                        Check {
                            checked <=> root.check-updates;
                            label: "Buscar actualizaciones al abrir";
                            toggled => { root.settings-changed(); }
                        }
                    }
                }

                if root.settings-section == 1: apariencia := ScrollView {
                    VerticalLayout {
                        width: apariencia.visible-width;
                        padding: 28px;
                        spacing: 18px;
                        alignment: start;
                        VerticalLayout {
                            spacing: 6px;
                            Text { text: "Apariencia"; font-size: 28px * Theme.fscale; font-weight: 700; color: Theme.text; }
                            Text {
                                text: "Los cambios se aplican al momento.";
                                font-size: 14px * Theme.fscale;
                                color: Theme.muted;
                            }
                        }

                        VerticalLayout {
                            spacing: 12px;
                            SectionTitle { text: "Tema"; }
                            HorizontalLayout {
                                spacing: 12px;
                                ThemeCard {
                                    title: "Cristal claro"; subtitle: "Translúcido, por defecto";
                                    bg: #eef1f6; pan: #ffffff80; bd: #ffffffd9; rad: 7px;
                                    selected: Theme.kind == 0;
                                    picked => { Theme.kind = 0; root.settings-changed(); }
                                }
                                ThemeCard {
                                    title: "Cristal oscuro"; subtitle: "Translúcido, de noche";
                                    bg: #0d1017; pan: #28304a8c; bd: #ffffff33; rad: 7px;
                                    selected: Theme.kind == 1;
                                    picked => { Theme.kind = 1; root.settings-changed(); }
                                }
                                ThemeCard {
                                    title: "Claro"; subtitle: "Plano, sin efectos";
                                    bg: #f4f5f7; pan: #ffffff; bd: #dfe2e8; rad: 4px;
                                    selected: Theme.kind == 2;
                                    picked => { Theme.kind = 2; root.settings-changed(); }
                                }
                                ThemeCard {
                                    title: "Grafito"; subtitle: "Oscuro plano";
                                    bg: #16181d; pan: #23272f; bd: #323844; rad: 4px;
                                    selected: Theme.kind == 3;
                                    picked => { Theme.kind = 3; root.settings-changed(); }
                                }
                                ThemeCard {
                                    title: "Alto contraste"; subtitle: "Máxima legibilidad";
                                    bg: #000000; pan: #000000; bd: #ffffff; rad: 1px;
                                    selected: Theme.kind == 4;
                                    picked => { Theme.kind = 4; root.settings-changed(); }
                                }
                            }
                            LabeledCheck {
                                text: "Cambiar entre claro y oscuro según el sistema";
                                checked: Theme.follow-system;
                                toggled(v) => { Theme.follow-system = v; root.settings-changed(); }
                            }
                        }

                        VerticalLayout {
                            SectionTitle { text: "Ventana"; }
                            SettingRow {
                                title: "Panel de propiedades";
                                subtitle: "Dónde se muestran los detalles del paquete o archivo elegido";
                                Segmented {
                                    options: ["Abajo", "A la derecha", "Oculto"];
                                    current <=> root.properties-panel;
                                    changed-by-user => { root.settings-changed(); }
                                }
                            }
                            SettingRow {
                                title: "Densidad";
                                subtitle: "Compacta muestra más descargas sin desplazar";
                                Segmented {
                                    options: ["Cómoda", "Compacta"];
                                    current: Theme.compact ? 1 : 0;
                                    changed-by-user(i) => { Theme.compact = i == 1; root.settings-changed(); }
                                }
                            }
                            SettingRow {
                                title: "Tamaño de letra";
                                subtitle: "Para leer mejor o para ver más cosas a la vez";
                                Segmented {
                                    options: ["Pequeña", "Normal", "Grande"];
                                    current: Theme.font-level;
                                    changed-by-user(i) => { Theme.font-level = i; root.settings-changed(); }
                                }
                            }
                            SettingRow {
                                title: "Escala de la interfaz";
                                subtitle: "Agranda o reduce toda la ventana. Automática sigue la escala de Windows. Se aplica al volver a abrir OmniLoad.";
                                ComboBox {
                                    width: 140px;
                                    model: ["Automática", "100 %", "125 %", "150 %", "175 %", "200 %"];
                                    current-index <=> root.ui-scale;
                                    selected => { root.settings-changed(); }
                                }
                            }
                            SettingRow {
                                title: "Color de acento";
                                subtitle: "Botones, barras de progreso y selección";
                                HorizontalLayout {
                                    spacing: 10px;
                                    for a[i] in [
                                        { name: "Azul", light: #0a5fd0, dark: #6fb1ff },
                                        { name: "Violeta", light: #6a3fd6, dark: #b39bff },
                                        { name: "Verde", light: #137a4b, dark: #5fd49a },
                                        { name: "Naranja", light: #b4500a, dark: #ffab6b },
                                        { name: "Rosa", light: #b8306a, dark: #ff8fc0 },
                                        { name: "Grafito", light: #3d4654, dark: #c9d1de },
                                    ]: Swatch {
                                        name: a.name;
                                        c: Theme.dark ? a.dark : a.light;
                                        selected: i == Theme.accent-index;
                                        picked => { Theme.accent-index = i; root.settings-changed(); }
                                    }
                                }
                            }
                        }

                        VerticalLayout {
                            SectionTitle { text: "Cristal"; }
                            SettingRow {
                                title: "Reducir transparencia";
                                subtitle: "Paneles opacos: más rápido en equipos modestos y más legible";
                                Check {
                                    checked: Theme.reduce-transparency;
                                    label: "Reducir transparencia";
                                    toggled(v) => { Theme.reduce-transparency = v; root.settings-changed(); }
                                }
                            }
                            SettingRow {
                                title: "Intensidad del desenfoque";
                                subtitle: "Cuánto se difuminan las sombras y los brillos de los paneles de cristal";
                                opacity: Theme.glass ? 1 : 0.5;
                                Segmented {
                                    options: ["Suave", "Normal", "Fuerte"];
                                    current: Theme.blur-level;
                                    changed-by-user(i) => { Theme.blur-level = i; root.settings-changed(); }
                                }
                            }
                        }

                        VerticalLayout {
                            SectionTitle { text: "Portapapeles"; }
                            SettingRow {
                                title: "Aviso al copiar enlaces";
                                subtitle: "Ventanita abajo a la derecha con los enlaces copiados mientras se comprueban";
                                Segmented {
                                    options: ["Completo", "Compacto", "Desactivado"];
                                    current <=> root.clip-popup;
                                    changed-by-user => { root.settings-changed(); }
                                }
                            }
                            SettingRow {
                                title: "Cerrar el aviso automáticamente";
                                subtitle: "Unos segundos después de terminar la comprobación se desvanece poco a poco (si pasas el ratón por encima, se queda)";
                                Check {
                                    checked <=> root.clip-autoclose;
                                    label: "Cerrar el aviso automáticamente";
                                    toggled => { root.settings-changed(); }
                                }
                            }
                        }
                
                    }
                }
            }
        }
    }

    // ---- Diálogo "Quitar descargas" ----
    if root.remove-dialog-open: Rectangle {
        background: #00000066;
        TouchArea { }
        Panel {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: min(520px, parent.width - 40px);
            height: 230px;
            background: Theme.glass ? (Theme.dark ? #1c2236f2 : #fffffff2) : Theme.panel;
            VerticalLayout {
                padding: 20px;
                spacing: 12px;
                Text { text: "Quitar descargas"; font-size: 18px * Theme.fscale; font-weight: 700; color: Theme.text; }
                Text {
                    text: "«" + root.sel-title + "»";
                    color: Theme.text;
                    font-weight: 600;
                    overflow: elide;
                }
                Text {
                    text: "«Quitar de la lista» solo las saca de OmniLoad: los archivos descargados se quedan en tu carpeta. «Quitar y borrar archivos» también borra del disco lo descargado (y la carpeta del paquete si se queda vacía).";
                    wrap: word-wrap;
                    color: Theme.muted;
                }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    spacing: 8px;
                    Btn {
                        text: "Quitar y borrar archivos";
                        icon: "M6 7h12M9 7V5h6v2M8 7l1 12h6l1-12";
                        icon-color: Theme.err;
                        clicked => { root.remove-dialog-open = false; root.sel-remove(true); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Btn {
                        text: "Cancelar";
                        clicked => { root.remove-dialog-open = false; }
                    }
                    Btn {
                        text: "Quitar de la lista";
                        primary: true;
                        clicked => { root.remove-dialog-open = false; root.sel-remove(false); }
                    }
                }
            }
        }
    }

    // ---- Diálogo "Añadir enlaces" ----
    if root.add-dialog-open: Rectangle {
        background: #00000066;
        TouchArea { }
        Panel {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: min(620px, parent.width - 40px);
            height: 320px;
            background: Theme.glass ? (Theme.dark ? #1c2236f2 : #fffffff2) : Theme.panel;
            VerticalLayout {
                padding: 20px;
                spacing: 12px;
                Text { text: "Añadir enlaces"; font-size: 18px * Theme.fscale; font-weight: 700; color: Theme.text; }
                Text {
                    text: "Pega uno o varios enlaces, sueltos o dentro de un texto. También sirven páginas con enlaces a archivos, o una lista guardada en un archivo .txt o .html.";
                    wrap: word-wrap;
                    color: Theme.muted;
                }
                links := TextEdit {
                    vertical-stretch: 1;
                    text <=> root.add-dialog-text;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: 8px;
                    Btn {
                        text: "Abrir archivo…";
                        icon: "M4 6h6l2 2h8v10H4z";
                        clicked => { root.add-links-file(); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Btn {
                        text: "Cancelar";
                        clicked => { root.add-dialog-open = false; }
                    }
                    Btn {
                        text: "Analizar enlaces";
                        primary: true;
                        clicked => { root.add-links(root.add-dialog-text); }
                    }
                }
            }
            init => { links.focus(); }
        }
    }

    // Barra de título propia y bordes para cambiar el tamaño (encima de todo).
    TitleBar {
        x: 0;
        y: 0;
        width: root.width;
        maximized: root.maximized;
        title-text: root.app-pr > 0 ? "OmniLoad " + root.app-version + " · PR #" + root.app-pr + " sin aprobar" : "OmniLoad " + root.app-version;
        drag => { root.win-drag(); }
        minimize => { root.win-minimize(); }
        toggle-maximize => { root.win-toggle-maximize(); }
        close => { root.win-close(); }
    }
    if !root.maximized: Rectangle {
        // 0 N, 1 NE, 2 E, 3 SE, 4 S, 5 SW, 6 W, 7 NW.
        ResizeEdge { edge: 0; x: 8px; y: 0; width: root.width - 16px; height: 4px; mouse-cursor: ns-resize; start(e) => { root.win-resize(e); } }
        ResizeEdge { edge: 4; x: 8px; y: root.height - 5px; width: root.width - 16px; height: 5px; mouse-cursor: ns-resize; start(e) => { root.win-resize(e); } }
        ResizeEdge { edge: 6; x: 0; y: 8px; width: 5px; height: root.height - 16px; mouse-cursor: ew-resize; start(e) => { root.win-resize(e); } }
        ResizeEdge { edge: 2; x: root.width - 5px; y: 8px; width: 5px; height: root.height - 16px; mouse-cursor: ew-resize; start(e) => { root.win-resize(e); } }
        ResizeEdge { edge: 7; x: 0; y: 0; width: 8px; height: 8px; mouse-cursor: nwse-resize; start(e) => { root.win-resize(e); } }
        ResizeEdge { edge: 1; x: root.width - 8px; y: 0; width: 8px; height: 8px; mouse-cursor: nesw-resize; start(e) => { root.win-resize(e); } }
        ResizeEdge { edge: 5; x: 0; y: root.height - 8px; width: 8px; height: 8px; mouse-cursor: nesw-resize; start(e) => { root.win-resize(e); } }
        ResizeEdge { edge: 3; x: root.width - 8px; y: root.height - 8px; width: 8px; height: 8px; mouse-cursor: nwse-resize; start(e) => { root.win-resize(e); } }
    }
}

// ---- Aviso de enlaces copiados (abajo a la derecha) ----

export struct PopRow {
    key: int,
    name: string,
    host: string,
    size: string,
    status: string,
    tone: int,
    checked: bool,
    // Disponible: se puede marcar.
    usable: bool,
}

// Un botón redondo solo con icono.
component RoundBtn inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> primary: false;
    in property <bool> filled: false;
    in property <length> size: 28px;
    in property <bool> enabled: true;
    callback clicked();
    accessible-role: button;
    accessible-label: label;
    accessible-action-default => { if enabled { clicked(); } }
    width: size;
    height: size;
    border-radius: size / 2;
    background: primary ? Theme.accent : touch.has-hover ? Theme.head : transparent;
    opacity: enabled ? 1 : 0.45;
    Icon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        size: root.size * 0.5;
        commands: root.icon;
        filled: root.filled;
        ink: root.primary ? Theme.on-accent : Theme.muted;
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component ClipPopup inherits Window {
    title: "OmniLoad · enlaces copiados";
    no-frame: true;
    always-on-top: true;
    background: transparent;
    default-font-family: "Inter";

    in property <bool> compact: true;
    // Desvanecerse para cerrarse (dura `fade-ms`; igual que popup::FADE).
    in property <bool> fading: false;
    property <duration> fade-ms: 1000ms;
    in property <[PopRow]> rows;
    in property <int> total;
    in property <int> ok;
    in property <int> bad;
    in property <bool> checking;
    in property <string> time-text;
    // Rueda: arco verde (aptos) y rojo (caídos), en un cuadro de 44×44.
    in property <string> ok-arc;
    in property <string> bad-arc;
    in property <int> to-download;
    in-out property <bool> autostart: true;
    out property <bool> hovered: hover.has-hover;

    callback play();
    callback download();
    callback open-grabber();
    callback discard();
    callback close();
    callback minimize();
    callback check(int, bool);
    callback autostart-changed();
    changed autostart => { autostart-changed(); }

    property <int> shown: min(rows.length, 5);
    // Tamaño que pide el aviso; Rust coloca la ventana con él.
    out property <length> want-width: compact ? 300px : 440px;
    out property <length> want-height: compact ? 72px : 56px + max(1, shown) * 44px + 96px;
    width: want-width;
    height: want-height;

    hover := TouchArea { }

    Panel {
        opacity: root.fading ? 0 : 1;
        animate opacity { duration: root.fading ? root.fade-ms : 150ms; easing: ease-in-out; }
        background: Theme.glass ? (Theme.dark ? #1c2236f5 : #fffffff5) : Theme.panel;
        drop-shadow-blur: 0px;
        drop-shadow-offset-y: 0px;

        // Compacta: play · texto · rueda · cerrar
        if root.compact: HorizontalLayout {
            padding-left: 14px;
            padding-right: 8px;
            spacing: 12px;
            alignment: stretch;
            RoundBtn {
                y: (parent.height - self.height) / 2;
                size: 40px;
                primary: true;
                filled: true;
                icon: "M8 5l12 7-12 7z";
                label: "Descargar los enlaces aptos";
                enabled: root.ok > 0;
                clicked => { root.play(); }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 2px;
                Text {
                    text: root.total == 1 ? "1 enlace copiado" : root.total + " enlaces copiados";
                    font-size: 14px * Theme.fscale;
                    font-weight: 600;
                    color: Theme.text;
                    overflow: elide;
                }
                Text {
                    text: root.time-text;
                    font-size: 12px * Theme.fscale;
                    color: Theme.muted;
                    overflow: elide;
                }
            }
            Rectangle {
                y: (parent.height - self.height) / 2;
                width: 44px;
                height: 44px;
                accessible-role: progress-indicator;
                accessible-label: root.ok + " de " + root.total + " enlaces aptos";
                Path {
                    width: 44px;
                    height: 44px;
                    viewbox-width: 44;
                    viewbox-height: 44;
                    commands: "M 22 4 A 18 18 0 1 1 22 40 A 18 18 0 1 1 22 4";
                    stroke: Theme.track;
                    stroke-width: 4px;
                    fill: transparent;
                }
                Path {
                    width: 44px;
                    height: 44px;
                    viewbox-width: 44;
                    viewbox-height: 44;
                    commands: root.ok-arc;
                    stroke: Theme.ok;
                    stroke-width: 4px;
                    fill: transparent;
                }
                Path {
                    width: 44px;
                    height: 44px;
                    viewbox-width: 44;
                    viewbox-height: 44;
                    commands: root.bad-arc;
                    stroke: Theme.err;
                    stroke-width: 4px;
                    fill: transparent;
                }
                Text {
                    text: root.ok + "/" + root.total;
                    font-size: root.total >= 100 ? 9px : 11px;
                    font-weight: 700;
                    color: Theme.text;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            RoundBtn {
                y: 8px;
                size: 24px;
                icon: "M6 6l12 12M18 6L6 18";
                label: "Cerrar";
                clicked => { root.close(); }
            }
        }

        // Completa: cabecera, lista y botones
        if !root.compact: VerticalLayout {
            padding: 12px;
            spacing: 8px;
            HorizontalLayout {
                spacing: 8px;
                height: 32px;
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 5px;
                    Text {
                        text: (root.total == 1 ? "1 enlace copiado" : root.total + " enlaces copiados")
                            + " · " + root.ok + " disponibles"
                            + (root.bad == 1 ? " · 1 caído" : root.bad > 1 ? " · " + root.bad + " caídos" : "");
                        font-size: 14px * Theme.fscale;
                        font-weight: 600;
                        color: Theme.text;
                        overflow: elide;
                    }
                    Rectangle {
                        height: 3px;
                        border-radius: 1.5px;
                        background: Theme.track;
                        clip: true;
                        Rectangle {
                            x: 0;
                            width: root.total == 0 ? 0px : parent.width * root.ok / root.total;
                            background: Theme.ok;
                        }
                        Rectangle {
                            x: root.total == 0 ? 0px : parent.width * root.ok / root.total;
                            width: root.total == 0 ? 0px : parent.width * root.bad / root.total;
                            background: Theme.err;
                        }
                    }
                }
                RoundBtn {
                    y: (parent.height - self.height) / 2;
                    icon: "M6 12h12";
                    label: "Minimizar";
                    clicked => { root.minimize(); }
                }
                RoundBtn {
                    y: (parent.height - self.height) / 2;
                    icon: "M6 6l12 12M18 6L6 18";
                    label: "Cerrar";
                    clicked => { root.close(); }
                }
            }
            Rectangle {
                height: max(1, root.shown) * 44px;
                border-radius: Theme.r2;
                background: Theme.panel2;
                clip: true;
                ListView {
                    for row in root.rows: Rectangle {
                        height: 44px;
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 10px;
                            Check {
                                y: (parent.height - self.height) / 2;
                                checked: row.checked;
                                enabled: row.usable;
                                label: "Incluir " + row.name;
                                toggled(v) => { root.check(row.key, v); }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                spacing: 1px;
                                Text {
                                    text: row.name;
                                    font-size: 13px * Theme.fscale;
                                    color: Theme.text;
                                    overflow: elide;
                                }
                                Text {
                                    text: row.host + (row.size == "" ? "" : " · " + row.size);
                                    font-size: 11px * Theme.fscale;
                                    color: Theme.muted;
                                    overflow: elide;
                                }
                            }
                            Text {
                                text: row.status;
                                font-size: 12px * Theme.fscale;
                                font-weight: 600;
                                color: Theme.tone(row.tone);
                                vertical-alignment: center;
                            }
                        }
                        Rectangle {
                            y: parent.height - 1px;
                            height: 1px;
                            background: Theme.line;
                        }
                    }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                LabeledCheck {
                    text: "Iniciar al añadir";
                    checked <=> root.autostart;
                }
                Rectangle { horizontal-stretch: 1; }
                Text {
                    text: root.time-text;
                    font-size: 12px * Theme.fscale;
                    color: Theme.muted;
                    vertical-alignment: center;
                }
            }
            HorizontalLayout {
                spacing: 6px;
                Btn {
                    text: "Descargar (" + root.to-download + ")";
                    icon: "M8 5l12 7-12 7z";
                    icon-filled: true;
                    primary: true;
                    enabled: root.to-download > 0;
                    clicked => { root.download(); }
                }
                Btn { text: "Abrir en el capturador"; clicked => { root.open-grabber(); } }
                Rectangle { horizontal-stretch: 1; }
                Btn { text: "Descartar"; clicked => { root.discard(); } }
            }
        }
    }
}
