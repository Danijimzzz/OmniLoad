// Ventana principal de OmniLoad, con la distribución de JDownloader: pestañas
// Descargas / Capturador de enlaces, tabla en árbol de paquetes, resumen y
// barra inferior. Ajustes › Apariencia cambia el tema en caliente.
//
// La lógica vive en Rust (src/); aquí solo está la presentación.

import { ComboBox, LineEdit, ListView, Palette, ScrollView, SpinBox, TextEdit } from "std-widgets.slint";

// ---------------------------------------------------------------- Tema ----

// Los cinco temas aprobados. `kind`: 0 Cristal claro, 1 Cristal oscuro,
// 2 Claro, 3 Grafito, 4 Alto contraste.
export global Theme {
    in-out property <int> kind: 0;
    in-out property <bool> follow-system: true;
    // Lo rellena la ventana al arrancar con el modo del sistema.
    in-out property <bool> system-dark: false;
    in-out property <int> accent-index: 0;
    in-out property <bool> compact: false;
    in-out property <bool> reduce-transparency: false;

    // Tema efectivo: con "según el sistema", cada tema pasa a su pareja
    // clara u oscura (Cristal claro ↔ Cristal oscuro, Claro ↔ Grafito).
    out property <int> eff: !follow-system || kind == 4 ? kind
        : kind <= 1 ? (system-dark ? 1 : 0)
        : (system-dark ? 3 : 2);
    out property <bool> dark: eff == 1 || eff == 3 || eff == 4;
    out property <bool> glass: eff <= 1 && !reduce-transparency;
    // Paleta de los paneles: "Reducir transparencia" usa la plana equivalente.
    out property <int> pal: glass || eff > 1 ? eff : (eff == 0 ? 2 : 3);

    out property <color> wall: [#eef1f6, #0d1017, #eef0f3, #121418, #000000][eff];
    out property <color> blob1: [#78a0f029, #5078dc1f, #00000000, #00000000, #00000000][eff];
    out property <color> blob2: [#beaaf01f, #8c64dc17, #00000000, #00000000, #00000000][eff];
    out property <color> panel: [#ffffff80, #1c223685, #ffffff, #1c1f25, #000000][pal];
    out property <color> panel2: [#ffffff5c, #28304a61, #f7f8fa, #22262d, #0d0d0d][pal];
    out property <color> head: [#ffffff8c, #323a5880, #f3f4f7, #252930, #000000][pal];
    out property <color> rim: [#ffffffc7, #ffffff29, #d9dde4, #323844, #ffffff][pal];
    out property <color> spec: [#fffffff2, #ffffff42, #00000000, #00000000, #00000000][pal];
    out property <color> shadow: [#1e285029, #00000073, #0000000d, #00000000, #00000000][pal];
    out property <color> text: [#0d1424, #f2f5fb, #14181f, #e9ecf2, #ffffff][pal];
    out property <color> muted: [#3e4a5f, #b3bdd0, #4f5867, #a3acbb, #e6e6e6][pal];
    out property <color> line: [#141e3c1a, #ffffff14, #e8eaef, #2b3039, #666666][pal];
    out property <color> track: [#141e3c1f, #ffffff24, #e3e6ec, #323844, #4d4d4d][pal];

    out property <color> accent: eff == 4 ? #ffd400 : dark
        ? [#6fb1ff, #b39bff, #5fd49a, #ffab6b, #ff8fc0, #c9d1de][accent-index]
        : [#0a5fd0, #6a3fd6, #137a4b, #b4500a, #b8306a, #3d4654][accent-index];
    out property <color> on-accent: eff == 4 ? #000000 : dark ? #06142b : #ffffff;
    out property <color> selbg: eff == 4 ? #332b00 : accent.with-alpha(0.16);
    out property <color> ok: eff == 4 ? #6dff9e : dark ? #5fd49a : #127a46;
    out property <color> warn: eff == 4 ? #ffd400 : dark ? #f3b860 : #93560a;
    out property <color> err: eff == 4 ? #ff7b7b : dark ? #ff8a80 : #b3261e;

    out property <length> r: eff <= 1 ? 18px : eff == 4 ? 2px : 8px;
    out property <length> r2: eff <= 1 ? 10px : eff == 4 ? 2px : 6px;
    out property <length> lw: eff == 4 ? 2px : 1px;
    out property <length> row-h: compact ? 26px : 34px;
    out property <length> font: compact ? 12.5px : 13px;

    // Color de un estado: 0 acento, 1 bien, 2 aviso, 3 error, 4 apagado.
    public pure function tone(t: int) -> color {
        if t == 1 { return ok; }
        if t == 2 { return warn; }
        if t == 3 { return err; }
        if t == 4 { return muted; }
        return accent;
    }
}

// ----------------------------------------------------------- Modelos ----

export struct DlRow {
    key: int,
    is-package: bool,
    expanded: bool,
    selected: bool,
    name: string,
    host: string,
    size: string,
    // 0..1; negativo si no se conoce el tamaño.
    fraction: float,
    progress: string,
    speed: string,
    eta: string,
    priority: string,
    status: string,
    tone: int,
}

export struct GrabTreeRow {
    key: int,
    is-package: bool,
    expanded: bool,
    selected: bool,
    checked: bool,
    dim: bool,
    name: string,
    host: string,
    size: string,
    avail: string,
    tone: int,
    priority: string,
    dest: string,
}

export struct Stat {
    label: string,
    value: string,
}

// ------------------------------------------------------ Componentes ----

component Icon inherits Path {
    in property <length> size: 14px;
    in property <bool> filled: false;
    in property <color> ink: Theme.text;
    width: size;
    height: size;
    viewbox-width: 24;
    viewbox-height: 24;
    stroke: filled ? transparent : ink;
    fill: filled ? ink : transparent;
    stroke-width: 2.2px;
    stroke-line-cap: round;
}

// Un panel de la ventana: cristal (translúcido, borde claro, brillo arriba y
// sombra) o plano, según el tema.
component Panel inherits Rectangle {
    background: Theme.panel;
    border-color: Theme.rim;
    border-width: Theme.lw;
    border-radius: Theme.r;
    drop-shadow-blur: Theme.glass ? 32px : 0px;
    drop-shadow-offset-y: Theme.glass ? 12px : 0px;
    drop-shadow-color: Theme.shadow;
    @children
    Rectangle {
        x: Theme.r;
        y: 1px;
        width: max(0px, parent.width - 2 * Theme.r);
        height: 1px;
        background: Theme.spec;
    }
}

// Una regla por tipo de archivo en Ajustes › Automático.
struct RuleRow {
    exts: string,
    folder: string,
}

component Btn inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> icon-filled: false;
    in property <color> icon-color: primary ? Theme.on-accent : Theme.text;
    in property <bool> primary: false;
    in property <bool> enabled: true;
    in property <string> label: text;
    callback clicked();

    accessible-role: button;
    accessible-label: label;
    accessible-action-default => { if enabled { clicked(); } }
    height: Theme.compact ? 30px : 34px;
    min-width: max(self.height, content.min-width);
    horizontal-stretch: 0;
    border-radius: Theme.r2;
    border-width: Theme.lw;
    border-color: primary ? Theme.accent : Theme.rim;
    background: primary ? Theme.accent : touch.has-hover ? Theme.head : Theme.panel2;
    opacity: enabled ? 1 : 0.45;
    content := HorizontalLayout {
        padding-left: text == "" ? 0px : 12px;
        padding-right: text == "" ? 0px : 12px;
        spacing: 6px;
        alignment: center;
        if icon != "": Icon {
            y: (parent.height - self.height) / 2;
            commands: icon;
            filled: icon-filled;
            ink: icon-color;
        }
        if text != "": Text {
            text: root.text;
            color: primary ? Theme.on-accent : Theme.text;
            font-size: Theme.font;
            font-weight: primary ? 600 : 500;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component Check inherits Rectangle {
    in-out property <bool> checked;
    in property <bool> enabled: true;
    in property <string> label;
    callback toggled(bool);
    accessible-role: checkbox;
    accessible-checkable: true;
    accessible-checked: checked;
    accessible-label: label;
    width: 16px;
    height: 16px;
    border-radius: 4px;
    border-width: checked ? 0px : 1.5px;
    border-color: Theme.muted;
    background: checked ? Theme.accent : transparent;
    opacity: enabled ? 1 : 0.4;
    if checked: Icon {
        size: 12px;
        x: 2px;
        y: 2px;
        commands: "M5 12l5 5 9-10";
        ink: Theme.on-accent;
        stroke-width: 3px;
    }
    TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}

component LabeledCheck inherits HorizontalLayout {
    in property <string> text;
    in-out property <bool> checked;
    callback toggled(bool);
    spacing: 8px;
    alignment: start;
    Check {
        y: (parent.height - self.height) / 2;
        checked <=> root.checked;
        label: root.text;
        toggled(v) => { root.toggled(v); }
    }
    Text {
        text: root.text;
        color: Theme.text;
        font-size: Theme.font;
        vertical-alignment: center;
        TouchArea {
            clicked => {
                root.checked = !root.checked;
                root.toggled(root.checked);
            }
        }
    }
}

component Sep inherits Rectangle {
    width: 1px;
    height: 24px;
    background: Theme.rim;
}

component Bar inherits Rectangle {
    in property <float> fraction;
    in property <string> text;
    in property <color> fill: Theme.accent;
    height: 16px;
    border-radius: 5px;
    background: Theme.track;
    clip: true;
    Rectangle {
        x: 0;
        width: parent.width * max(0, root.fraction);
        background: root.fill;
        opacity: 0.85;
    }
    Text {
        x: 6px;
        text: root.text;
        font-size: 11px;
        font-weight: 600;
        color: Theme.text;
        vertical-alignment: center;
    }
}

component Cell inherits Text {
    font-size: Theme.font;
    color: Theme.text;
    vertical-alignment: center;
    overflow: elide;
}

component HeadCell inherits Rectangle {
    in property <string> text;
    border-width: 0;
    Text {
        x: 10px;
        width: parent.width - 12px;
        text: root.text;
        font-size: 11.5px;
        font-weight: 600;
        color: Theme.muted;
        vertical-alignment: center;
        overflow: elide;
    }
    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        background: Theme.line;
    }
}

component Expander inherits Rectangle {
    in property <bool> expanded;
    callback toggle();
    width: 22px;
    height: 22px;
    accessible-role: button;
    accessible-label: expanded ? "Contraer paquete" : "Desplegar paquete";
    accessible-action-default => { toggle(); }
    Icon {
        size: 12px;
        x: 5px;
        y: 5px;
        commands: expanded ? "M6 9l6 6 6-6" : "M9 6l6 6-6 6";
        stroke-width: 3px;
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggle(); }
    }
}

component FolderIcon inherits Icon {
    size: 16px;
    commands: "M3 6a2 2 0 0 1 2-2h4l2 3h8a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z";
    ink: Theme.accent;
    stroke-width: 2px;
}

// Columnas de la tabla de descargas.
global DlCols {
    out property <length> host: 150px;
    out property <length> size: 90px;
    out property <length> progress: 170px;
    out property <length> speed: 95px;
    out property <length> eta: 95px;
    out property <length> prio: 75px;
    out property <length> status: 210px;
}

component DlHeader inherits Rectangle {
    height: 32px;
    background: Theme.head;
    HorizontalLayout {
        HeadCell { text: "Nombre"; horizontal-stretch: 1; }
        HeadCell { text: "Host"; width: DlCols.host; }
        HeadCell { text: "Tamaño"; width: DlCols.size; }
        HeadCell { text: "Progreso"; width: DlCols.progress; }
        HeadCell { text: "Velocidad"; width: DlCols.speed; }
        HeadCell { text: "Restante"; width: DlCols.eta; }
        HeadCell { text: "Prioridad"; width: DlCols.prio; }
        HeadCell { text: "Estado"; width: DlCols.status; }
    }
    Rectangle {
        y: parent.height - Theme.lw;
        height: Theme.lw;
        background: Theme.rim;
    }
}

component DlLine inherits Rectangle {
    in property <DlRow> item;
    callback clicked();
    callback toggle();
    height: Theme.row-h;
    background: item.selected ? Theme.selbg : item.is-package ? Theme.panel2 : transparent;
    TouchArea { clicked => { root.clicked(); } }
    HorizontalLayout {
        HorizontalLayout {
            horizontal-stretch: 1;
            padding-left: item.is-package ? 6px : 58px;
            padding-right: 8px;
            spacing: 6px;
            if item.is-package: Expander {
                y: (parent.height - self.height) / 2;
                expanded: item.expanded;
                toggle => { root.toggle(); }
            }
            if item.is-package: FolderIcon { y: (parent.height - self.height) / 2; }
            Cell {
                text: item.name;
                font-weight: item.is-package ? 600 : 400;
                horizontal-stretch: 1;
            }
        }
        Cell { text: item.host; color: Theme.muted; width: DlCols.host; }
        Cell { text: item.size; width: DlCols.size; }
        Rectangle {
            width: DlCols.progress;
            Bar {
                x: 0;
                width: parent.width - 10px;
                y: (parent.height - self.height) / 2;
                fraction: item.fraction;
                text: item.progress;
                fill: Theme.tone(item.tone);
            }
        }
        Cell { text: item.speed; width: DlCols.speed; }
        Cell { text: item.eta; width: DlCols.eta; }
        Cell { text: item.priority; width: DlCols.prio; }
        Cell {
            text: item.status;
            width: DlCols.status;
            color: Theme.tone(item.tone);
            font-weight: 600;
        }
    }
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.line;
    }
}

global GrabCols {
    out property <length> host: 160px;
    out property <length> size: 90px;
    out property <length> avail: 230px;
    out property <length> prio: 75px;
    out property <length> dest: 240px;
}

component GrabHeader inherits Rectangle {
    height: 32px;
    background: Theme.head;
    HorizontalLayout {
        HeadCell { text: "Nombre"; horizontal-stretch: 1; }
        HeadCell { text: "Host"; width: GrabCols.host; }
        HeadCell { text: "Tamaño"; width: GrabCols.size; }
        HeadCell { text: "Disponibilidad"; width: GrabCols.avail; }
        HeadCell { text: "Prioridad"; width: GrabCols.prio; }
        HeadCell { text: "Guardar en"; width: GrabCols.dest; }
    }
    Rectangle {
        y: parent.height - Theme.lw;
        height: Theme.lw;
        background: Theme.rim;
    }
}

component GrabLine inherits Rectangle {
    in property <GrabTreeRow> item;
    callback clicked();
    callback toggle();
    callback check(bool);
    height: Theme.row-h;
    background: item.selected ? Theme.selbg : item.is-package ? Theme.panel2 : transparent;
    TouchArea { clicked => { root.clicked(); } }
    HorizontalLayout {
        HorizontalLayout {
            horizontal-stretch: 1;
            padding-left: item.is-package ? 6px : 38px;
            padding-right: 8px;
            spacing: 8px;
            if item.is-package: Expander {
                y: (parent.height - self.height) / 2;
                expanded: item.expanded;
                toggle => { root.toggle(); }
            }
            Check {
                y: (parent.height - self.height) / 2;
                checked: item.checked;
                label: "Incluir " + item.name;
                toggled(v) => { root.check(v); }
            }
            if item.is-package: FolderIcon { y: (parent.height - self.height) / 2; }
            Cell {
                text: item.name;
                font-weight: item.is-package ? 600 : 400;
                opacity: item.dim ? 0.55 : 1;
                horizontal-stretch: 1;
            }
        }
        Cell { text: item.host; color: Theme.muted; width: GrabCols.host; }
        Cell { text: item.size; width: GrabCols.size; }
        Cell {
            text: item.avail;
            width: GrabCols.avail;
            color: Theme.tone(item.tone);
            font-weight: 600;
        }
        Cell { text: item.priority; width: GrabCols.prio; }
        Cell { text: item.dest; color: Theme.muted; width: GrabCols.dest; }
    }
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.line;
    }
}

component FieldLabel inherits Text {
    font-size: 12px;
    font-weight: 600;
    color: Theme.muted;
}

component SectionTitle inherits Text {
    font-size: 15px;
    font-weight: 700;
    color: Theme.text;
}

// Botones de opción en fila ("Abajo | A la derecha | Oculto").
component Segmented inherits Rectangle {
    in property <[string]> options;
    in-out property <int> current;
    callback changed-by-user(int);
    border-radius: Theme.r2;
    border-width: Theme.lw;
    border-color: Theme.rim;
    background: Theme.panel2;
    HorizontalLayout {
        padding: 3px;
        spacing: 2px;
        for opt[i] in options: Rectangle {
            height: 32px;
            border-radius: Theme.r2 - 2px;
            background: i == root.current ? Theme.panel : transparent;
            border-width: i == root.current ? Theme.lw : 0px;
            border-color: Theme.rim;
            accessible-role: button;
            accessible-label: opt;
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                Text {
                    text: opt;
                    font-size: 13px;
                    font-weight: 600;
                    color: Theme.text;
                    vertical-alignment: center;
                }
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.current = i;
                    root.changed-by-user(i);
                }
            }
        }
    }
}

component SettingRow inherits HorizontalLayout {
    in property <string> title;
    in property <string> subtitle;
    padding-top: 12px;
    padding-bottom: 12px;
    spacing: 16px;
    VerticalLayout {
        horizontal-stretch: 1;
        alignment: center;
        spacing: 2px;
        Text { text: root.title; font-size: 14px; font-weight: 600; color: Theme.text; }
        if root.subtitle != "": Text {
            text: root.subtitle;
            font-size: 13px;
            color: Theme.muted;
            wrap: word-wrap;
        }
    }
    @children
}

// Miniatura de un tema en Ajustes › Apariencia.
component ThemeCard inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <color> bg;
    in property <color> pan;
    in property <color> bd;
    in property <length> rad;
    in property <bool> selected;
    callback picked();
    accessible-role: button;
    accessible-label: title;
    height: 150px;
    preferred-width: 0px;
    horizontal-stretch: 1;
    border-radius: Theme.r2 + 4px;
    border-width: 2px;
    border-color: selected ? Theme.accent : transparent;
    background: Theme.panel2;
    VerticalLayout {
        padding: 10px;
        spacing: 6px;
        Rectangle {
            height: 80px;
            border-radius: 10px;
            background: root.bg;
            border-width: 1px;
            border-color: #7f7f7f4d;
            clip: true;
            Rectangle {
                x: 8px; y: 8px; width: parent.width * 0.3; height: parent.height - 16px;
                border-radius: root.rad; background: root.pan; border-width: 1px; border-color: root.bd;
            }
            Rectangle {
                x: parent.width * 0.42; y: 8px; width: parent.width * 0.58 - 8px; height: 18px;
                border-radius: root.rad; background: root.pan; border-width: 1px; border-color: root.bd;
            }
            Rectangle {
                x: parent.width * 0.42; y: 34px; width: parent.width * 0.58 - 8px; height: 18px;
                border-radius: root.rad; background: root.pan; border-width: 1px; border-color: root.bd;
            }
            Rectangle {
                x: parent.width * 0.42; y: 60px; width: parent.width * 0.3; height: 6px;
                border-radius: 3px; background: Theme.accent;
            }
        }
        Text { text: root.title; font-size: 13px; font-weight: 600; color: Theme.text; }
        Text { text: root.subtitle; font-size: 12px; color: Theme.muted; }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.picked(); }
    }
}

component Swatch inherits Rectangle {
    in property <color> c;
    in property <string> name;
    in property <bool> selected;
    callback picked();
    accessible-role: button;
    accessible-label: name;
    width: 32px;
    height: 32px;
    border-radius: 16px;
    background: c;
    border-width: selected ? 3px : 1px;
    border-color: selected ? Theme.text : Theme.rim;
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.picked(); }
    }
}

component TabBtn inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    in property <int> badge: 0;
    callback clicked();
    accessible-role: tab;
    accessible-label: text;
    height: 38px;
    border-radius: Theme.r2;
    border-width: active ? Theme.lw : 0px;
    border-color: Theme.rim;
    background: active ? Theme.panel2 : transparent;
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 8px;
        Text {
            text: root.text;
            font-size: 14px;
            font-weight: 600;
            color: active ? Theme.text : Theme.muted;
            vertical-alignment: center;
        }
        if badge > 0: Rectangle {
            y: (parent.height - 18px) / 2;
            height: 18px;
            min-width: 22px;
            border-radius: 9px;
            background: Theme.accent;
            HorizontalLayout {
                padding-left: 7px;
                padding-right: 7px;
                Text {
                    text: badge;
                    font-size: 11px;
                    font-weight: 700;
                    color: Theme.on-accent;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
            }
        }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// ------------------------------------------------------------ Ventana ----

export component AppWindow inherits Window {
    title: "OmniLoad";
    icon: @image-url("icon.png");
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 980px;
    min-height: 560px;
    background: Theme.wall;
    default-font-size: Theme.font;

    // 0 Descargas, 1 Capturador de enlaces, 2 Ajustes.
    in-out property <int> tab: 0;
    in-out property <int> settings-section: 1;
    in property <string> message;
    in property <bool> message-is-error;

    // Ajustes que se guardan.
    in-out property <int> properties-panel: 0;
    in-out property <int> max-active: 3;
    in-out property <int> connections: 8;
    in-out property <int> speed-limit: 0;
    in-out property <int> max-per-server: 8;
    in-out property <bool> keep-downloading: false;
    in-out property <bool> close-to-tray: true;
    in-out property <bool> minimize-to-tray: true;
    in-out property <bool> notify-done: true;
    // Hay icono en la bandeja del sistema.
    in property <bool> tray-available: false;
    // Versión y aviso de versión nueva.
    in property <string> app-version;
    // 0 sin comprobar, 1 comprobando, 2 al día, 3 hay una nueva, 4 aún no hay
    // versiones publicadas, 5 error.
    in property <int> update-state: 0;
    in property <string> update-text;
    in-out property <bool> check-updates: true;
    // Automático: horario, reglas por tipo, acción al terminar, inicio con el sistema.
    in-out property <bool> schedule-enabled: false;
    // Días del horario: bit 0 lunes … bit 6 domingo.
    in-out property <int> schedule-days: 127;
    in property <[bool]> schedule-day-on: [true, true, true, true, true, true, true];
    in-out property <string> schedule-from: "00:00";
    in-out property <string> schedule-to: "07:00";
    in property <bool> schedule-error: false;
    callback schedule-day-toggled(int);
    in-out property <[RuleRow]> rules;
    callback rule-add();
    callback rule-remove(int);
    callback rule-exts-edited(int, string);
    callback rule-choose(int);
    // 0 nada, 1 cerrar OmniLoad, 2 suspender, 3 apagar.
    in-out property <int> finish-action: 0;
    in-out property <bool> autostart: false;
    // Cuenta atrás de la acción al terminar (vacío = no hay).
    in property <string> finish-text;
    callback finish-cancel();
    callback check-updates-now();
    callback open-release();
    in-out property <bool> watch-clipboard: true;
    in-out property <int> clip-popup: 1;
    in-out property <bool> package-folders: true;
    in-out property <bool> single-file-folders: true;
    in-out property <bool> clip-autoclose: true;
    in-out property <string> download-dir;

    // Cabecera.
    in property <string> header-speed;
    in property <string> speed-path: "M 0 28 L 140 28";

    // Descargas.
    in property <[DlRow]> downloads;
    in property <[Stat]> totals;
    in property <string> net-text;
    // Panel de propiedades: 0 nada, 1 paquete, 2 archivo.
    in property <int> sel-kind;
    in property <string> sel-title;
    in property <[Stat]> sel-lines;
    in property <int> sel-priority: 1;
    in property <bool> sel-can-start;
    in property <bool> sel-can-stop;

    // Capturador.
    in property <[GrabTreeRow]> grabbed;
    in property <int> grab-count;
    in property <int> grab-selected-count;
    in property <int> grab-offline-count;
    in property <string> grab-summary;
    in property <bool> pkg-selected;
    in property <string> pkg-title;
    in-out property <string> pkg-name-text;
    in-out property <string> pkg-folder-text;
    in property <int> pkg-priority: 1;

    // Diálogo "Añadir enlaces".
    in-out property <bool> add-dialog-open: false;
    in-out property <string> add-dialog-text;

    callback add-links(string);
    callback add-links-file();
    callback dl-click(int, bool);
    callback dl-toggle(int);
    callback dl-search(string);
    callback start-all();
    callback pause-all();
    callback stop-all();
    callback queue-settings-changed();
    callback sel-start();
    callback sel-stop();
    // Quitar la selección de Descargas; con `true` también borra los archivos.
    callback sel-remove(bool);
    in-out property <bool> remove-dialog-open: false;
    callback change-sel-priority(int);
    callback sel-open-folder();

    callback grab-click(int, bool);
    callback grab-toggle(int);
    callback grab-check(int, bool, bool);
    callback grab-select-all(bool);
    callback grab-remove-offline();
    callback grab-recheck();
    callback grab-clear();
    callback grab-search(string);
    // true = "Iniciar descargas"; false = "Añadir a descargas".
    callback grab-to-downloads(bool);
    callback pkg-rename(string);
    callback pkg-folder(string);
    callback pkg-choose-folder();
    callback change-pkg-priority(int);
    callback pkg-remove();

    callback settings-changed();
    callback choose-download-dir();

    private property <[string]> priorities: ["Alta", "Normal", "Baja"];
    private property <bool> theme-dark: Theme.dark;
    changed theme-dark => { Palette.color-scheme = Theme.dark ? ColorScheme.dark : ColorScheme.light; }
    changed max-active => { queue-settings-changed(); }
    changed connections => { queue-settings-changed(); }
    changed speed-limit => { queue-settings-changed(); }
    changed max-per-server => { queue-settings-changed(); }
    changed watch-clipboard => { settings-changed(); }
    init => {
        Theme.system-dark = Palette.color-scheme == ColorScheme.dark;
        Palette.color-scheme = Theme.dark ? ColorScheme.dark : ColorScheme.light;
    }

    // Fondo: dos manchas de color muy suaves que se ven a través del cristal.
    if Theme.glass: Rectangle {
        x: root.width * 0.15 - self.width / 2;
        y: root.height * 0.2 - self.height / 2;
        width: root.width * 0.9;
        height: self.width;
        background: @radial-gradient(circle, Theme.blob1 0%, transparent 50%);
    }
    if Theme.glass: Rectangle {
        x: root.width * 0.85 - self.width / 2;
        y: root.height * 0.85 - self.height / 2;
        width: root.width * 0.9;
        height: self.width;
        background: @radial-gradient(circle, Theme.blob2 0%, transparent 50%);
    }

    VerticalLayout {
        padding: 14px;
        spacing: 10px;

        // ---- Cabecera ----
        Panel {
            height: 52px;
            HorizontalLayout {
                padding: 7px;
                padding-left: 12px;
                spacing: 6px;
                Rectangle {
                    y: (parent.height - self.height) / 2;
                    width: 26px;
                    height: 26px;
                    border-radius: 8px;
                    background: Theme.accent;
                    Icon {
                        size: 15px;
                        x: 5.5px;
                        y: 5.5px;
                        commands: "M12 3v12M7 10l5 5 5-5M5 21h14";
                        ink: Theme.on-accent;
                        stroke-width: 2.6px;
                    }
                }
                Text {
                    text: "OmniLoad";
                    font-size: 15px;
                    font-weight: 700;
                    color: Theme.text;
                    vertical-alignment: center;
                }
                Rectangle { width: 12px; }
                TabBtn {
                    text: "Descargas";
                    active: root.tab == 0;
                    clicked => { root.tab = 0; }
                }
                TabBtn {
                    text: "Capturador de enlaces";
                    active: root.tab == 1;
                    badge: root.grab-count;
                    clicked => { root.tab = 1; }
                }
                Rectangle { horizontal-stretch: 1; }
                Path {
                    y: (parent.height - self.height) / 2;
                    width: 140px;
                    height: 30px;
                    viewbox-width: 140;
                    viewbox-height: 30;
                    commands: root.speed-path;
                    opacity: root.header-speed == "" ? 0 : 1;
                    stroke: Theme.accent;
                    stroke-width: 2px;
                    fill: transparent;
                    accessible-role: image;
                    accessible-label: "Velocidad de los últimos 60 segundos";
                }
                Text {
                    text: root.header-speed;
                    min-width: 90px;
                    font-size: 13px;
                    font-weight: 700;
                    color: Theme.text;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
                if root.update-state == 3: Btn {
                    y: (parent.height - self.height) / 2;
                    text: "Hay una versión nueva";
                    icon: "M12 5v10M7 11l5 5 5-5M5 19h14";
                    icon-color: Theme.ok;
                    label: root.update-text;
                    clicked => { root.settings-section = 2; root.tab = 2; }
                }
                Btn {
                    y: (parent.height - self.height) / 2;
                    text: "Ajustes";
                    icon: "M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z";
                    primary: root.tab == 2;
                    clicked => { root.tab = root.tab == 2 ? 0 : 2; }
                }
            }
        }

        if root.finish-text != "": Panel {
            HorizontalLayout {
                padding: 10px;
                spacing: 12px;
                Text {
                    horizontal-stretch: 1;
                    text: root.finish-text;
                    wrap: word-wrap;
                    font-size: 13px;
                    font-weight: 600;
                    color: Theme.warn;
                    vertical-alignment: center;
                }
                Btn { text: "Cancelar"; primary: true; clicked => { root.finish-cancel(); } }
            }
        }

        if root.message != "": Text {
            text: root.message;
            wrap: word-wrap;
            font-size: 13px;
            color: root.message-is-error ? Theme.err : Theme.muted;
        }

        // ---- Descargas ----
        if root.tab == 0: VerticalLayout {
            vertical-stretch: 1;
            spacing: 10px;

            // Barra de controles, encima de la lista.
            Panel {
                HorizontalLayout {
                    padding: 8px;
                    spacing: 6px;
                    Btn {
                        text: "Añadir enlaces";
                        icon: "M12 5v14M5 12h14";
                        primary: true;
                        clicked => { root.add-dialog-open = true; }
                    }
                    Sep { y: (parent.height - self.height) / 2; }
                    Btn {
                        label: "Iniciar descargas";
                        icon: "M7 4l13 8-13 8z";
                        icon-filled: true;
                        icon-color: Theme.ok;
                        clicked => { root.start-all(); }
                    }
                    Btn {
                        label: "Pausar descargas";
                        icon: "M9 5v14M15 5v14";
                        clicked => { root.pause-all(); }
                    }
                    Btn {
                        label: "Detener descargas";
                        icon: "M5 5h14v14H5z";
                        icon-filled: true;
                        icon-color: Theme.err;
                        clicked => { root.stop-all(); }
                    }
                    Sep { y: (parent.height - self.height) / 2; }
                    Text { text: "Simultáneas"; color: Theme.text; vertical-alignment: center; }
                    SpinBox {
                        width: 90px;
                        minimum: 1;
                        maximum: 20;
                        value <=> root.max-active;
                    }
                    Text { text: "Conexiones por archivo"; color: Theme.text; vertical-alignment: center; }
                    SpinBox {
                        width: 90px;
                        minimum: 1;
                        maximum: 32;
                        value <=> root.connections;
                    }
                    Text { text: "Límite"; color: Theme.text; vertical-alignment: center; }
                    ComboBox {
                        width: 120px;
                        // Mismo orden que SPEED_LIMITS en settings.rs.
                        model: ["Sin límite", "256 KB/s", "512 KB/s", "1 MB/s", "2 MB/s", "5 MB/s", "10 MB/s", "20 MB/s", "50 MB/s", "100 MB/s"];
                        current-index <=> root.speed-limit;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    LineEdit {
                        width: 240px;
                        placeholder-text: "Buscar paquetes o archivos";
                        edited(t) => { root.dl-search(t); }
                    }
                }
            }

            HorizontalLayout {
                vertical-stretch: 1;
                spacing: 10px;
                Panel {
                    horizontal-stretch: 1;
                    clip: true;
                    VerticalLayout {
                        DlHeader { }
                        if root.downloads.length == 0: Rectangle {
                            vertical-stretch: 1;
                            Text {
                                text: "Aún no hay descargas.\nPulsa «Añadir enlaces» y elige qué bajar en el Capturador de enlaces.";
                                horizontal-alignment: center;
                                color: Theme.muted;
                            }
                        }
                        if root.downloads.length > 0: ListView {
                            vertical-stretch: 1;
                            for row in root.downloads: DlLine {
                                item: row;
                                clicked => { root.dl-click(row.key, row.is-package); }
                                toggle => { root.dl-toggle(row.key); }
                            }
                        }
                    }
                }
                if root.properties-panel == 1 && root.sel-kind > 0: Panel {
                    width: 320px;
                    VerticalLayout {
                        padding: 16px;
                        spacing: 10px;
                        Text {
                            text: root.sel-title;
                            font-size: 14px;
                            font-weight: 700;
                            color: Theme.text;
                            wrap: word-wrap;
                        }
                        for l in root.sel-lines: VerticalLayout {
                            spacing: 2px;
                            FieldLabel { text: l.label; }
                            Text { text: l.value; color: Theme.text; font-size: 13px; wrap: word-wrap; }
                        }
                        FieldLabel { text: "Prioridad"; }
                        ComboBox {
                            model: root.priorities;
                            current-index: root.sel-priority;
                            selected => { root.change-sel-priority(self.current-index); }
                        }
                        HorizontalLayout {
                            spacing: 6px;
                            if root.sel-can-start: Btn {
                                text: "Iniciar";
                                icon: "M7 4l13 8-13 8z";
                                icon-filled: true;
                                icon-color: Theme.ok;
                                clicked => { root.sel-start(); }
                            }
                            if root.sel-can-stop: Btn {
                                text: "Detener";
                                icon: "M5 5h14v14H5z";
                                icon-filled: true;
                                icon-color: Theme.err;
                                clicked => { root.sel-stop(); }
                            }
                        }
                        HorizontalLayout {
                            spacing: 6px;
                            Btn { text: "Abrir carpeta"; clicked => { root.sel-open-folder(); } }
                            Btn { text: "Quitar"; clicked => { root.remove-dialog-open = true; } }
                        }
                        Rectangle { vertical-stretch: 1; }
                    }
                }
            }

            if root.properties-panel == 0 && root.sel-kind > 0: Panel {
                VerticalLayout {
                    padding: 12px;
                    padding-left: 16px;
                    padding-right: 16px;
                    spacing: 10px;
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: (root.sel-kind == 1 ? "Paquete: " : "Archivo: ") + root.sel-title;
                            font-size: 13px;
                            font-weight: 700;
                            color: Theme.text;
                            overflow: elide;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }
                        if root.sel-can-start: Btn {
                            text: "Iniciar";
                            icon: "M7 4l13 8-13 8z";
                            icon-filled: true;
                            icon-color: Theme.ok;
                            clicked => { root.sel-start(); }
                        }
                        if root.sel-can-stop: Btn {
                            text: "Detener";
                            icon: "M5 5h14v14H5z";
                            icon-filled: true;
                            icon-color: Theme.err;
                            clicked => { root.sel-stop(); }
                        }
                        ComboBox {
                            width: 120px;
                            model: root.priorities;
                            current-index: root.sel-priority;
                            selected => { root.change-sel-priority(self.current-index); }
                        }
                        Btn { text: "Abrir carpeta"; clicked => { root.sel-open-folder(); } }
                        Btn { text: "Quitar"; clicked => { root.remove-dialog-open = true; } }
                    }
                    HorizontalLayout {
                        spacing: 24px;
                        for l in root.sel-lines: VerticalLayout {
                            spacing: 2px;
                            horizontal-stretch: l.label == "Enlace" || l.label == "Carpeta" || l.label == "Detalle" ? 2 : 1;
                            FieldLabel { text: l.label; }
                            Text { text: l.value; color: Theme.text; font-size: 13px; overflow: elide; }
                        }
                    }
                }
            }

            // Resumen.
            Panel {
                HorizontalLayout {
                    padding: 10px;
                    padding-left: 16px;
                    padding-right: 16px;
                    spacing: 24px;
                    for t in root.totals: VerticalLayout {
                        spacing: 2px;
                        Text { text: t.label; font-size: 12px; color: Theme.muted; }
                        Text { text: t.value; font-size: 14px; font-weight: 700; color: Theme.text; }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        min-width: 200px;
                        spacing: 4px;
                        Text { text: "Redes en uso"; font-size: 12px; color: Theme.muted; }
                        Rectangle {
                            height: 14px;
                            border-radius: 5px;
                            background: Theme.track;
                            clip: true;
                            Rectangle {
                                x: 0;
                                width: root.header-speed == "" ? 0px : parent.width;
                                background: Theme.accent;
                            }
                        }
                        Text { text: root.net-text; font-size: 12.5px; color: Theme.text; }
                    }
                }
            }
        }

        // ---- Capturador de enlaces ----
        if root.tab == 1: VerticalLayout {
            vertical-stretch: 1;
            spacing: 10px;

            HorizontalLayout {
                vertical-stretch: 1;
                spacing: 10px;
                Panel {
                    horizontal-stretch: 1;
                    clip: true;
                    VerticalLayout {
                        GrabHeader { }
                        if root.grabbed.length == 0: Rectangle {
                            vertical-stretch: 1;
                            Text {
                                text: "Pulsa «Añadir enlaces» o copia un enlace.\nAquí verás los archivos que contiene, agrupados en paquetes, antes de descargar nada.";
                                horizontal-alignment: center;
                                color: Theme.muted;
                            }
                        }
                        if root.grabbed.length > 0: ListView {
                            vertical-stretch: 1;
                            for row in root.grabbed: GrabLine {
                                item: row;
                                clicked => { root.grab-click(row.key, row.is-package); }
                                toggle => { root.grab-toggle(row.key); }
                                check(v) => { root.grab-check(row.key, row.is-package, v); }
                            }
                        }
                    }
                }
                if root.properties-panel == 1 && root.pkg-selected: Panel {
                    width: 320px;
                    VerticalLayout {
                        padding: 16px;
                        spacing: 8px;
                        Text {
                            text: "Propiedades del paquete";
                            font-size: 14px;
                            font-weight: 700;
                            color: Theme.text;
                        }
                        FieldLabel { text: "Nombre del paquete"; }
                        LineEdit {
                            text <=> root.pkg-name-text;
                            edited(t) => { root.pkg-rename(t); }
                        }
                        FieldLabel { text: "Guardar en"; }
                        LineEdit {
                            text <=> root.pkg-folder-text;
                            edited(t) => { root.pkg-folder(t); }
                        }
                        Btn { text: "Elegir carpeta…"; clicked => { root.pkg-choose-folder(); } }
                        FieldLabel { text: "Prioridad"; }
                        ComboBox {
                            model: root.priorities;
                            current-index: root.pkg-priority;
                            selected => { root.change-pkg-priority(self.current-index); }
                        }
                        Btn { text: "Quitar paquete"; clicked => { root.pkg-remove(); } }
                        Rectangle { vertical-stretch: 1; }
                    }
                }
            }

            if root.properties-panel == 0 && root.pkg-selected: Panel {
                VerticalLayout {
                    padding: 12px;
                    padding-left: 16px;
                    padding-right: 16px;
                    spacing: 10px;
                    Text {
                        text: "Propiedades del paquete: " + root.pkg-title;
                        font-size: 13px;
                        font-weight: 700;
                        color: Theme.text;
                        overflow: elide;
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 4px;
                            FieldLabel { text: "Nombre del paquete"; }
                            LineEdit {
                                text <=> root.pkg-name-text;
                                edited(t) => { root.pkg-rename(t); }
                            }
                        }
                        VerticalLayout {
                            horizontal-stretch: 2;
                            spacing: 4px;
                            FieldLabel { text: "Guardar en"; }
                            HorizontalLayout {
                                spacing: 6px;
                                LineEdit {
                                    text <=> root.pkg-folder-text;
                                    edited(t) => { root.pkg-folder(t); }
                                }
                                Btn { text: "Elegir…"; clicked => { root.pkg-choose-folder(); } }
                            }
                        }
                        VerticalLayout {
                            width: 140px;
                            spacing: 4px;
                            FieldLabel { text: "Prioridad"; }
                            ComboBox {
                                model: root.priorities;
                                current-index: root.pkg-priority;
                                selected => { root.change-pkg-priority(self.current-index); }
                            }
                        }
                        VerticalLayout {
                            alignment: end;
                            Btn { text: "Quitar paquete"; clicked => { root.pkg-remove(); } }
                        }
                    }
                }
            }

            Panel {
                HorizontalLayout {
                    padding: 8px;
                    spacing: 6px;
                    Btn {
                        text: "Añadir enlaces";
                        icon: "M12 5v14M5 12h14";
                        clicked => { root.add-dialog-open = true; }
                    }
                    Btn { text: "Todos"; clicked => { root.grab-select-all(true); } }
                    Btn { text: "Ninguno"; clicked => { root.grab-select-all(false); } }
                    if root.grab-offline-count > 0: Btn {
                        text: "Reintentar caídos";
                        clicked => { root.grab-recheck(); }
                    }
                    Btn { text: "Quitar caídos"; clicked => { root.grab-remove-offline(); } }
                    Btn { text: "Vaciar"; clicked => { root.grab-clear(); } }
                    LineEdit {
                        width: 120px;
                        placeholder-text: "Buscar";
                        edited(t) => { root.grab-search(t); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Text {
                        text: root.grab-summary;
                        color: Theme.muted;
                        vertical-alignment: center;
                    }
                    Btn {
                        text: "Añadir a descargas";
                        enabled: root.grab-selected-count > 0;
                        clicked => { root.grab-to-downloads(false); }
                    }
                    Btn {
                        text: "Iniciar descargas";
                        icon: "M7 4l13 8-13 8z";
                        icon-filled: true;
                        primary: true;
                        enabled: root.grab-selected-count > 0;
                        clicked => { root.grab-to-downloads(true); }
                    }
                }
            }
        }

        // ---- Ajustes ----
        if root.tab == 2: HorizontalLayout {
            vertical-stretch: 1;
            spacing: 16px;
            Panel {
                width: 240px;
                VerticalLayout {
                    padding: 16px;
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 2px;
                    alignment: start;
                    Text {
                        text: "Ajustes";
                        font-size: 20px;
                        font-weight: 700;
                        color: Theme.text;
                    }
                    Rectangle { height: 12px; }
                    for s[i] in ["General", "Apariencia", "Versión", "Automático"]: Rectangle {
                        height: 40px;
                        border-radius: Theme.r2;
                        background: i == root.settings-section ? Theme.panel2 : transparent;
                        border-width: i == root.settings-section ? Theme.lw : 0px;
                        border-color: Theme.rim;
                        accessible-role: button;
                        accessible-label: s;
                        Text {
                            x: 12px;
                            text: s;
                            font-size: 13px;
                            font-weight: 600;
                            color: Theme.text;
                            vertical-alignment: center;
                        }
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.settings-section = i; }
                        }
                    }
                }
            }

            Panel {
                horizontal-stretch: 1;
                if root.settings-section == 0: general := ScrollView {
                  VerticalLayout {
                    width: general.visible-width;
                    padding: 28px;
                    spacing: 6px;
                    alignment: start;
                    Text { text: "General"; font-size: 28px; font-weight: 700; color: Theme.text; }
                    SettingRow {
                        title: "Carpeta de descargas";
                        subtitle: "Donde se guarda todo lo que descargas.";
                        LineEdit {
                            width: 360px;
                            text <=> root.download-dir;
                            accepted => { root.settings-changed(); }
                        }
                        Btn { text: "Elegir…"; clicked => { root.choose-download-dir(); } }
                    }
                    SettingRow {
                        title: "Una carpeta por paquete";
                        subtitle: "Cada paquete va a una subcarpeta con su nombre (se quitan los caracteres que el sistema no admite). Se puede cambiar en el panel del paquete del Capturador.";
                        Check {
                            checked <=> root.package-folders;
                            label: "Una carpeta por paquete";
                            toggled => { root.settings-changed(); }
                        }
                    }
                    SettingRow {
                        title: "También para un solo archivo";
                        subtitle: "Si se desactiva, los paquetes de un archivo van directos a la carpeta de descargas.";
                        opacity: root.package-folders ? 1 : 0.5;
                        Check {
                            checked <=> root.single-file-folders;
                            enabled: root.package-folders;
                            label: "Carpeta también para paquetes de un solo archivo";
                            toggled => { root.settings-changed(); }
                        }
                    }
                    SettingRow {
                        title: "Conexiones por servidor";
                        subtitle: "Cuántas conexiones se abren como mucho a una misma web sumando todas las descargas (0 = sin tope). Si el servidor acepta menos, OmniLoad lo aprende solo y lo recuerda.";
                        SpinBox {
                            width: 90px;
                            minimum: 0;
                            maximum: 64;
                            value <=> root.max-per-server;
                        }
                    }
                    SettingRow {
                        title: "Cerrar a la bandeja";
                        subtitle: root.tray-available
                            ? "La X de la ventana la esconde junto al reloj y las descargas siguen. Para salir del todo: «Salir» en el menú del icono."
                            : "Este escritorio no tiene bandeja del sistema: cerrar la ventana sale de OmniLoad. En GNOME, instala la extensión «AppIndicator» para tenerla.";
                        opacity: root.tray-available ? 1 : 0.5;
                        Check {
                            checked <=> root.close-to-tray;
                            enabled: root.tray-available;
                            label: "Cerrar a la bandeja";
                            toggled => { root.settings-changed(); }
                        }
                    }
                    SettingRow {
                        title: "Minimizar a la bandeja";
                        subtitle: "Al minimizar, la ventana desaparece de la barra de tareas y queda solo el icono de la bandeja.";
                        opacity: root.tray-available ? 1 : 0.5;
                        Check {
                            checked <=> root.minimize-to-tray;
                            enabled: root.tray-available;
                            label: "Minimizar a la bandeja";
                            toggled => { root.settings-changed(); }
                        }
                    }
                    SettingRow {
                        title: "Avisar al terminar";
                        subtitle: "Una notificación del sistema cuando termina un archivo o un paquete entero, o si falla (solo si no estás mirando la ventana).";
                        Check {
                            checked <=> root.notify-done;
                            label: "Avisar al terminar";
                            toggled => { root.settings-changed(); }
                        }
                    }
                    SettingRow {
                        title: "Seguir descargando al salir";
                        subtitle: "Al salir de OmniLoad las descargas continúan en segundo plano. Al volver a abrirlo las verás tal cual. Desde la terminal: «omni service stop» para pararlas.";
                        Check {
                            checked <=> root.keep-downloading;
                            label: "Seguir descargando al salir";
                            toggled => { root.settings-changed(); }
                        }
                    }
                    SettingRow {
                        title: "Vigilar portapapeles";
                        subtitle: "Los enlaces que copies aparecen solos en el Capturador de enlaces.";
                        Check {
                            checked <=> root.watch-clipboard;
                            label: "Vigilar portapapeles";
                            toggled => { root.settings-changed(); }
                        }
                    }
                  }
                }

                if root.settings-section == 3: auto := ScrollView {
                  VerticalLayout {
                    width: auto.visible-width;
                    padding: 28px;
                    spacing: 6px;
                    alignment: start;
                    Text { text: "Automático"; font-size: 28px; font-weight: 700; color: Theme.text; }
                    SettingRow {
                        title: "Horario de descargas";
                        subtitle: "Solo descarga en los días y las horas que elijas. Fuera de ellas todo queda en pausa (con el progreso guardado) y sigue solo al llegar la hora. Si la hora de fin es menor que la de inicio, el tramo acaba al día siguiente (por ejemplo, de 23:00 a 07:00).";
                        Check {
                            checked <=> root.schedule-enabled;
                            label: "Usar horario";
                            toggled => { root.settings-changed(); }
                        }
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        opacity: root.schedule-enabled ? 1 : 0.5;
                        for d[i] in ["L", "M", "X", "J", "V", "S", "D"]: Rectangle {
                            width: 34px;
                            height: 34px;
                            border-radius: Theme.r2;
                            background: root.schedule-day-on[i] ? Theme.accent : Theme.panel2;
                            accessible-role: checkbox;
                            accessible-label: d;
                            Text {
                                text: d;
                                font-size: 13px;
                                font-weight: 600;
                                color: root.schedule-day-on[i] ? Theme.on-accent : Theme.text;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            TouchArea {
                                enabled: root.schedule-enabled;
                                mouse-cursor: pointer;
                                clicked => { root.schedule-day-toggled(i); }
                            }
                        }
                        Rectangle { width: 16px; }
                        Text { text: "De"; color: Theme.muted; font-size: 13px; vertical-alignment: center; }
                        LineEdit {
                            width: 80px;
                            enabled: root.schedule-enabled;
                            text <=> root.schedule-from;
                            placeholder-text: "00:00";
                            accepted => { root.settings-changed(); }
                        }
                        Text { text: "a"; color: Theme.muted; font-size: 13px; vertical-alignment: center; }
                        LineEdit {
                            width: 80px;
                            enabled: root.schedule-enabled;
                            text <=> root.schedule-to;
                            placeholder-text: "07:00";
                            accepted => { root.settings-changed(); }
                        }
                        Btn { text: "Aplicar"; enabled: root.schedule-enabled; clicked => { root.settings-changed(); } }
                    }
                    if root.schedule-error: Text {
                        text: "Escribe las horas como HH:MM, por ejemplo 23:30.";
                        color: Theme.err;
                        font-size: 13px;
                    }
                    SettingRow {
                        title: "Carpeta según el tipo de archivo";
                        subtitle: "Por ejemplo, vídeos a una carpeta y .zip a otra. Escribe las extensiones separadas por comas (mp4, mkv). Gana la primera regla que coincida; un paquete con carpeta propia no se toca.";
                        Btn { text: "Añadir regla"; icon: "M12 5v14M5 12h14"; clicked => { root.rule-add(); } }
                    }
                    for r[i] in root.rules: HorizontalLayout {
                        spacing: 8px;
                        height: 36px;
                        LineEdit {
                            width: 200px;
                            text: r.exts;
                            placeholder-text: "mp4, mkv, avi";
                            edited(t) => { root.rule-exts-edited(i, t); }
                            accepted => { root.settings-changed(); }
                        }
                        Text { text: "→"; color: Theme.muted; vertical-alignment: center; }
                        Text {
                            horizontal-stretch: 1;
                            text: r.folder == "" ? "(elige una carpeta)" : r.folder;
                            color: r.folder == "" ? Theme.muted : Theme.text;
                            overflow: elide;
                            vertical-alignment: center;
                            font-size: 13px;
                        }
                        Btn { text: "Elegir…"; clicked => { root.rule-choose(i); } }
                        Btn { text: "Quitar"; clicked => { root.rule-remove(i); } }
                    }
                    SettingRow {
                        title: "Al terminar todas las descargas";
                        subtitle: "Qué hacer cuando no queda nada por descargar. Suspender y apagar dan 60 segundos para cancelar con un aviso.";
                        ComboBox {
                            width: 200px;
                            model: ["No hacer nada", "Cerrar OmniLoad", "Suspender el equipo", "Apagar el equipo"];
                            current-index <=> root.finish-action;
                            selected => { root.settings-changed(); }
                        }
                    }
                    SettingRow {
                        title: "Iniciar con el sistema";
                        subtitle: "OmniLoad arranca al encender el equipo, escondido en la bandeja, y las descargas siguen sin que tengas que abrirlo.";
                        Check {
                            checked <=> root.autostart;
                            label: "Iniciar con el sistema";
                            toggled => { root.settings-changed(); }
                        }
                    }
                  }
                }

                if root.settings-section == 2: VerticalLayout {
                    padding: 28px;
                    spacing: 6px;
                    alignment: start;
                    Text { text: "Versión"; font-size: 28px; font-weight: 700; color: Theme.text; }
                    SettingRow {
                        title: "OmniLoad " + root.app-version;
                        subtitle: root.update-text;
                        if root.update-state == 3: Btn {
                            text: "Ver la versión nueva";
                            primary: true;
                            icon: "M12 5v10M7 11l5 5 5-5M5 19h14";
                            clicked => { root.open-release(); }
                        }
                        Btn {
                            text: root.update-state == 1 ? "Comprobando…" : "Buscar actualizaciones";
                            enabled: root.update-state != 1;
                            clicked => { root.check-updates-now(); }
                        }
                    }
                    SettingRow {
                        title: "Buscar al abrir";
                        subtitle: "Al abrir OmniLoad pregunta a GitHub cuál es la última versión y te avisa si hay una nueva. No descarga ni instala nada: tú decides si actualizas. Solo envía el nombre y el número de versión del programa.";
                        Check {
                            checked <=> root.check-updates;
                            label: "Buscar actualizaciones al abrir";
                            toggled => { root.settings-changed(); }
                        }
                    }
                }

                if root.settings-section == 1: apariencia := ScrollView {
                    VerticalLayout {
                        width: apariencia.visible-width;
                        padding: 28px;
                        spacing: 18px;
                        alignment: start;
                        VerticalLayout {
                            spacing: 6px;
                            Text { text: "Apariencia"; font-size: 28px; font-weight: 700; color: Theme.text; }
                            Text {
                                text: "Los cambios se aplican al momento.";
                                font-size: 14px;
                                color: Theme.muted;
                            }
                        }

                        VerticalLayout {
                            spacing: 12px;
                            SectionTitle { text: "Tema"; }
                            HorizontalLayout {
                                spacing: 12px;
                                ThemeCard {
                                    title: "Cristal claro"; subtitle: "Translúcido, por defecto";
                                    bg: #eef1f6; pan: #ffffff80; bd: #ffffffd9; rad: 7px;
                                    selected: Theme.kind == 0;
                                    picked => { Theme.kind = 0; root.settings-changed(); }
                                }
                                ThemeCard {
                                    title: "Cristal oscuro"; subtitle: "Translúcido, de noche";
                                    bg: #0d1017; pan: #28304a8c; bd: #ffffff33; rad: 7px;
                                    selected: Theme.kind == 1;
                                    picked => { Theme.kind = 1; root.settings-changed(); }
                                }
                                ThemeCard {
                                    title: "Claro"; subtitle: "Plano, sin efectos";
                                    bg: #f4f5f7; pan: #ffffff; bd: #dfe2e8; rad: 4px;
                                    selected: Theme.kind == 2;
                                    picked => { Theme.kind = 2; root.settings-changed(); }
                                }
                                ThemeCard {
                                    title: "Grafito"; subtitle: "Oscuro plano";
                                    bg: #16181d; pan: #23272f; bd: #323844; rad: 4px;
                                    selected: Theme.kind == 3;
                                    picked => { Theme.kind = 3; root.settings-changed(); }
                                }
                                ThemeCard {
                                    title: "Alto contraste"; subtitle: "Máxima legibilidad";
                                    bg: #000000; pan: #000000; bd: #ffffff; rad: 1px;
                                    selected: Theme.kind == 4;
                                    picked => { Theme.kind = 4; root.settings-changed(); }
                                }
                            }
                            LabeledCheck {
                                text: "Cambiar entre claro y oscuro según el sistema";
                                checked: Theme.follow-system;
                                toggled(v) => { Theme.follow-system = v; root.settings-changed(); }
                            }
                        }

                        VerticalLayout {
                            SectionTitle { text: "Ventana"; }
                            SettingRow {
                                title: "Panel de propiedades";
                                subtitle: "Dónde se muestran los detalles del paquete o archivo elegido";
                                Segmented {
                                    options: ["Abajo", "A la derecha", "Oculto"];
                                    current <=> root.properties-panel;
                                    changed-by-user => { root.settings-changed(); }
                                }
                            }
                            SettingRow {
                                title: "Densidad";
                                subtitle: "Compacta muestra más descargas sin desplazar";
                                Segmented {
                                    options: ["Cómoda", "Compacta"];
                                    current: Theme.compact ? 1 : 0;
                                    changed-by-user(i) => { Theme.compact = i == 1; root.settings-changed(); }
                                }
                            }
                            SettingRow {
                                title: "Color de acento";
                                subtitle: "Botones, barras de progreso y selección";
                                HorizontalLayout {
                                    spacing: 10px;
                                    for a[i] in [
                                        { name: "Azul", light: #0a5fd0, dark: #6fb1ff },
                                        { name: "Violeta", light: #6a3fd6, dark: #b39bff },
                                        { name: "Verde", light: #137a4b, dark: #5fd49a },
                                        { name: "Naranja", light: #b4500a, dark: #ffab6b },
                                        { name: "Rosa", light: #b8306a, dark: #ff8fc0 },
                                        { name: "Grafito", light: #3d4654, dark: #c9d1de },
                                    ]: Swatch {
                                        name: a.name;
                                        c: Theme.dark ? a.dark : a.light;
                                        selected: i == Theme.accent-index;
                                        picked => { Theme.accent-index = i; root.settings-changed(); }
                                    }
                                }
                            }
                        }

                        VerticalLayout {
                            SectionTitle { text: "Cristal"; }
                            SettingRow {
                                title: "Reducir transparencia";
                                subtitle: "Paneles opacos: más rápido en equipos modestos y más legible";
                                Check {
                                    checked: Theme.reduce-transparency;
                                    label: "Reducir transparencia";
                                    toggled(v) => { Theme.reduce-transparency = v; root.settings-changed(); }
                                }
                            }
                        }

                        VerticalLayout {
                            SectionTitle { text: "Portapapeles"; }
                            SettingRow {
                                title: "Aviso al copiar enlaces";
                                subtitle: "Ventanita abajo a la derecha con los enlaces copiados mientras se comprueban";
                                Segmented {
                                    options: ["Completo", "Compacto", "Desactivado"];
                                    current <=> root.clip-popup;
                                    changed-by-user => { root.settings-changed(); }
                                }
                            }
                            SettingRow {
                                title: "Cerrar el aviso automáticamente";
                                subtitle: "Unos segundos después de terminar la comprobación se desvanece poco a poco (si pasas el ratón por encima, se queda)";
                                Check {
                                    checked <=> root.clip-autoclose;
                                    label: "Cerrar el aviso automáticamente";
                                    toggled => { root.settings-changed(); }
                                }
                            }
                        }
                
                    }
                }
            }
        }
    }

    // ---- Diálogo "Quitar descargas" ----
    if root.remove-dialog-open: Rectangle {
        background: #00000066;
        TouchArea { }
        Panel {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: min(520px, parent.width - 40px);
            height: 230px;
            background: Theme.glass ? (Theme.dark ? #1c2236f2 : #fffffff2) : Theme.panel;
            VerticalLayout {
                padding: 20px;
                spacing: 12px;
                Text { text: "Quitar descargas"; font-size: 18px; font-weight: 700; color: Theme.text; }
                Text {
                    text: "«" + root.sel-title + "»";
                    color: Theme.text;
                    font-weight: 600;
                    overflow: elide;
                }
                Text {
                    text: "«Quitar de la lista» solo las saca de OmniLoad: los archivos descargados se quedan en tu carpeta. «Quitar y borrar archivos» también borra del disco lo descargado (y la carpeta del paquete si se queda vacía).";
                    wrap: word-wrap;
                    color: Theme.muted;
                }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    spacing: 8px;
                    Btn {
                        text: "Quitar y borrar archivos";
                        icon: "M6 7h12M9 7V5h6v2M8 7l1 12h6l1-12";
                        icon-color: Theme.err;
                        clicked => { root.remove-dialog-open = false; root.sel-remove(true); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Btn {
                        text: "Cancelar";
                        clicked => { root.remove-dialog-open = false; }
                    }
                    Btn {
                        text: "Quitar de la lista";
                        primary: true;
                        clicked => { root.remove-dialog-open = false; root.sel-remove(false); }
                    }
                }
            }
        }
    }

    // ---- Diálogo "Añadir enlaces" ----
    if root.add-dialog-open: Rectangle {
        background: #00000066;
        TouchArea { }
        Panel {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: min(620px, parent.width - 40px);
            height: 320px;
            background: Theme.glass ? (Theme.dark ? #1c2236f2 : #fffffff2) : Theme.panel;
            VerticalLayout {
                padding: 20px;
                spacing: 12px;
                Text { text: "Añadir enlaces"; font-size: 18px; font-weight: 700; color: Theme.text; }
                Text {
                    text: "Pega uno o varios enlaces, sueltos o dentro de un texto. También sirven páginas con enlaces a archivos, o una lista guardada en un archivo .txt o .html.";
                    wrap: word-wrap;
                    color: Theme.muted;
                }
                links := TextEdit {
                    vertical-stretch: 1;
                    text <=> root.add-dialog-text;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: 8px;
                    Btn {
                        text: "Abrir archivo…";
                        icon: "M4 6h6l2 2h8v10H4z";
                        clicked => { root.add-links-file(); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Btn {
                        text: "Cancelar";
                        clicked => { root.add-dialog-open = false; }
                    }
                    Btn {
                        text: "Analizar enlaces";
                        primary: true;
                        clicked => { root.add-links(root.add-dialog-text); }
                    }
                }
            }
            init => { links.focus(); }
        }
    }
}

// ---- Aviso de enlaces copiados (abajo a la derecha) ----

export struct PopRow {
    key: int,
    name: string,
    host: string,
    size: string,
    status: string,
    tone: int,
    checked: bool,
    // Disponible: se puede marcar.
    usable: bool,
}

// Un botón redondo solo con icono.
component RoundBtn inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> primary: false;
    in property <bool> filled: false;
    in property <length> size: 28px;
    in property <bool> enabled: true;
    callback clicked();
    accessible-role: button;
    accessible-label: label;
    accessible-action-default => { if enabled { clicked(); } }
    width: size;
    height: size;
    border-radius: size / 2;
    background: primary ? Theme.accent : touch.has-hover ? Theme.head : transparent;
    opacity: enabled ? 1 : 0.45;
    Icon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        size: root.size * 0.5;
        commands: root.icon;
        filled: root.filled;
        ink: root.primary ? Theme.on-accent : Theme.muted;
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component ClipPopup inherits Window {
    title: "OmniLoad · enlaces copiados";
    no-frame: true;
    always-on-top: true;
    background: transparent;

    in property <bool> compact: true;
    // Desvanecerse para cerrarse (dura `fade-ms`; igual que popup::FADE).
    in property <bool> fading: false;
    property <duration> fade-ms: 1000ms;
    in property <[PopRow]> rows;
    in property <int> total;
    in property <int> ok;
    in property <int> bad;
    in property <bool> checking;
    in property <string> time-text;
    // Rueda: arco verde (aptos) y rojo (caídos), en un cuadro de 44×44.
    in property <string> ok-arc;
    in property <string> bad-arc;
    in property <int> to-download;
    in-out property <bool> autostart: true;
    out property <bool> hovered: hover.has-hover;

    callback play();
    callback download();
    callback open-grabber();
    callback discard();
    callback close();
    callback minimize();
    callback check(int, bool);
    callback autostart-changed();
    changed autostart => { autostart-changed(); }

    property <int> shown: min(rows.length, 5);
    // Tamaño que pide el aviso; Rust coloca la ventana con él.
    out property <length> want-width: compact ? 300px : 440px;
    out property <length> want-height: compact ? 72px : 56px + max(1, shown) * 44px + 96px;
    width: want-width;
    height: want-height;

    hover := TouchArea { }

    Panel {
        opacity: root.fading ? 0 : 1;
        animate opacity { duration: root.fading ? root.fade-ms : 150ms; easing: ease-in-out; }
        background: Theme.glass ? (Theme.dark ? #1c2236f5 : #fffffff5) : Theme.panel;
        drop-shadow-blur: 0px;
        drop-shadow-offset-y: 0px;

        // Compacta: play · texto · rueda · cerrar
        if root.compact: HorizontalLayout {
            padding-left: 14px;
            padding-right: 8px;
            spacing: 12px;
            alignment: stretch;
            RoundBtn {
                y: (parent.height - self.height) / 2;
                size: 40px;
                primary: true;
                filled: true;
                icon: "M8 5l12 7-12 7z";
                label: "Descargar los enlaces aptos";
                enabled: root.ok > 0;
                clicked => { root.play(); }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 2px;
                Text {
                    text: root.total == 1 ? "1 enlace copiado" : root.total + " enlaces copiados";
                    font-size: 14px;
                    font-weight: 600;
                    color: Theme.text;
                    overflow: elide;
                }
                Text {
                    text: root.time-text;
                    font-size: 12px;
                    color: Theme.muted;
                    overflow: elide;
                }
            }
            Rectangle {
                y: (parent.height - self.height) / 2;
                width: 44px;
                height: 44px;
                accessible-role: progress-indicator;
                accessible-label: root.ok + " de " + root.total + " enlaces aptos";
                Path {
                    width: 44px;
                    height: 44px;
                    viewbox-width: 44;
                    viewbox-height: 44;
                    commands: "M 22 4 A 18 18 0 1 1 22 40 A 18 18 0 1 1 22 4";
                    stroke: Theme.track;
                    stroke-width: 4px;
                    fill: transparent;
                }
                Path {
                    width: 44px;
                    height: 44px;
                    viewbox-width: 44;
                    viewbox-height: 44;
                    commands: root.ok-arc;
                    stroke: Theme.ok;
                    stroke-width: 4px;
                    fill: transparent;
                }
                Path {
                    width: 44px;
                    height: 44px;
                    viewbox-width: 44;
                    viewbox-height: 44;
                    commands: root.bad-arc;
                    stroke: Theme.err;
                    stroke-width: 4px;
                    fill: transparent;
                }
                Text {
                    text: root.ok + "/" + root.total;
                    font-size: root.total >= 100 ? 9px : 11px;
                    font-weight: 700;
                    color: Theme.text;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            RoundBtn {
                y: 8px;
                size: 24px;
                icon: "M6 6l12 12M18 6L6 18";
                label: "Cerrar";
                clicked => { root.close(); }
            }
        }

        // Completa: cabecera, lista y botones
        if !root.compact: VerticalLayout {
            padding: 12px;
            spacing: 8px;
            HorizontalLayout {
                spacing: 8px;
                height: 32px;
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 5px;
                    Text {
                        text: (root.total == 1 ? "1 enlace copiado" : root.total + " enlaces copiados")
                            + " · " + root.ok + " disponibles"
                            + (root.bad == 1 ? " · 1 caído" : root.bad > 1 ? " · " + root.bad + " caídos" : "");
                        font-size: 14px;
                        font-weight: 600;
                        color: Theme.text;
                        overflow: elide;
                    }
                    Rectangle {
                        height: 3px;
                        border-radius: 1.5px;
                        background: Theme.track;
                        clip: true;
                        Rectangle {
                            x: 0;
                            width: root.total == 0 ? 0px : parent.width * root.ok / root.total;
                            background: Theme.ok;
                        }
                        Rectangle {
                            x: root.total == 0 ? 0px : parent.width * root.ok / root.total;
                            width: root.total == 0 ? 0px : parent.width * root.bad / root.total;
                            background: Theme.err;
                        }
                    }
                }
                RoundBtn {
                    y: (parent.height - self.height) / 2;
                    icon: "M6 12h12";
                    label: "Minimizar";
                    clicked => { root.minimize(); }
                }
                RoundBtn {
                    y: (parent.height - self.height) / 2;
                    icon: "M6 6l12 12M18 6L6 18";
                    label: "Cerrar";
                    clicked => { root.close(); }
                }
            }
            Rectangle {
                height: max(1, root.shown) * 44px;
                border-radius: Theme.r2;
                background: Theme.panel2;
                clip: true;
                ListView {
                    for row in root.rows: Rectangle {
                        height: 44px;
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 10px;
                            Check {
                                y: (parent.height - self.height) / 2;
                                checked: row.checked;
                                enabled: row.usable;
                                label: "Incluir " + row.name;
                                toggled(v) => { root.check(row.key, v); }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                spacing: 1px;
                                Text {
                                    text: row.name;
                                    font-size: 13px;
                                    color: Theme.text;
                                    overflow: elide;
                                }
                                Text {
                                    text: row.host + (row.size == "" ? "" : " · " + row.size);
                                    font-size: 11px;
                                    color: Theme.muted;
                                    overflow: elide;
                                }
                            }
                            Text {
                                text: row.status;
                                font-size: 12px;
                                font-weight: 600;
                                color: Theme.tone(row.tone);
                                vertical-alignment: center;
                            }
                        }
                        Rectangle {
                            y: parent.height - 1px;
                            height: 1px;
                            background: Theme.line;
                        }
                    }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                LabeledCheck {
                    text: "Iniciar al añadir";
                    checked <=> root.autostart;
                }
                Rectangle { horizontal-stretch: 1; }
                Text {
                    text: root.time-text;
                    font-size: 12px;
                    color: Theme.muted;
                    vertical-alignment: center;
                }
            }
            HorizontalLayout {
                spacing: 6px;
                Btn {
                    text: "Descargar (" + root.to-download + ")";
                    icon: "M8 5l12 7-12 7z";
                    icon-filled: true;
                    primary: true;
                    enabled: root.to-download > 0;
                    clicked => { root.download(); }
                }
                Btn { text: "Abrir en el capturador"; clicked => { root.open-grabber(); } }
                Rectangle { horizontal-stretch: 1; }
                Btn { text: "Descartar"; clicked => { root.discard(); } }
            }
        }
    }
}
